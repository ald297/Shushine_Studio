# =======================================================
# PLANTILLA DE VARIABLES DE ENTORNO — SHUSHINE STUDIO
# =======================================================
# Copia este archivo como .env o .env.local en tu entorno local.
# PROHIBIDO subir archivos .env o .env.local con credenciales a Git.

# Configuración de Conexión a Supabase (PostgreSQL / Auth / Storage)
SUPABASE_URL=https://<tu-project-id>.supabase.co
SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
# Nota: SUPABASE_SERVICE_ROLE_KEY solo debe usarse en scripts de administración o backend seguro.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_de_servicio_privada_aqui

# URL Base de la Web API C# ASP.NET Core
API_BASE_URL=https://localhost:7001/api
