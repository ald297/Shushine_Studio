<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShushineStudio.Mobile.Presentation.Components.ServiceCardView"
             x:Name="ThisServiceCard">
    <Border StrokeShape="RoundRectangle 16"
            Stroke="{StaticResource Border}"
            StrokeThickness="1"
            BackgroundColor="{StaticResource Surface}"
            Padding="14"
            Margin="0,0,0,12">
        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
            <!-- Miniatura / Placeholder del Servicio -->
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="0.5"
                    BackgroundColor="{StaticResource BackgroundSecondary}"
                    WidthRequest="80"
                    HeightRequest="80"
                    VerticalOptions="Center">
                <Grid>
                    <Image Source="{Binding Source={x:Reference ThisServiceCard}, Path=ImageUrl}"
                           Aspect="AspectFill"
                           IsVisible="{Binding Source={x:Reference ThisServiceCard}, Path=ImageUrl, Converter={x:Null}}" />
                    <!-- Icono fallback si no hay imagen -->
                    <Label Text="✨"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Datos del Servicio -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                <!-- Categoría Pill -->
                <Label Text="{Binding Source={x:Reference ThisServiceCard}, Path=Category}"
                       Style="{StaticResource CaptionLabelStyle}"
                       TextColor="{StaticResource Secondary}"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation" />

                <!-- Nombre del Servicio -->
                <Label Text="{Binding Source={x:Reference ThisServiceCard}, Path=ServiceName}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="TailTruncation"
                       MaxLines="2" />

                <!-- Duración y Precio -->
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding Source={x:Reference ThisServiceCard}, Path=DurationText}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Label Text="•"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Label Text="{Binding Source={x:Reference ThisServiceCard}, Path=PriceText}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Botón de Acción -->
            <Button Grid.Column="2"
                    Text="{Binding Source={x:Reference ThisServiceCard}, Path=ActionText}"
                    Command="{Binding Source={x:Reference ThisServiceCard}, Path=ActionCommand}"
                    CommandParameter="{Binding Source={x:Reference ThisServiceCard}, Path=ActionCommandParameter}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="40"
                    Padding="14,0"
                    FontSize="13"
                    CornerRadius="12"
                    VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
