<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Appointments"
             xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Appointments.BookingSummaryPage"
             x:DataType="vm:BookingSummaryViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Resumen de Reserva">

    <Grid RowDefinitions="*, Auto">
        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Encabezado -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Confirmación de tu Cita"
                           Style="{StaticResource HeaderLabelStyle}" />
                    <Label Text="Revisa los detalles antes de completar tu reserva"
                           Style="{StaticResource SubheaderLabelStyle}" />
                </VerticalStackLayout>

                <!-- Tarjeta 1: Detalle del Servicio y Estilista -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Detalles del Turno"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryColor}" />

                        <!-- Servicio -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="💅" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Servicio.Nombre, FallbackValue='Tratamiento de Belleza'}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{StaticResource TextColorPrimary}" />
                                <Label Text="{Binding Servicio.DuracionFormateada, FallbackValue='0 min', StringFormat='Duración estimada: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextColorSecondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />

                        <!-- Estilista -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="👩‍🦰" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Estilista.NombreCompleto, FallbackValue='Profesional del Salón'}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{StaticResource TextColorPrimary}" />
                                <Label Text="{Binding Estilista.EspecialidadPrincipal, FallbackValue='Especialista', StringFormat='Especialidad: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextColorSecondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />

                        <!-- Horario y Fecha -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="📅" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding HorarioCompleto, FallbackValue='Fecha por confirmar'}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource TextColorPrimary}" />
                                <Label Text="Llegar 5 minutos antes de la hora indicada"
                                       FontSize="12"
                                       TextColor="{StaticResource TextColorSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta 2: Desglose Financiero Oficial (Subtotal, IVA 13%, Total) -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Desglose Financiero"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryColor}" />

                        <!-- Subtotal -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Subtotal del Servicio" TextColor="{StaticResource TextColorSecondary}" />
                            <Label Grid.Column="1" Text="{Binding SubtotalFormateado}" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                        </Grid>

                        <!-- IVA 13% -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="IVA (13% Ley El Salvador)" TextColor="{StaticResource TextColorSecondary}" />
                            <Label Grid.Column="1" Text="{Binding IvaFormateado}" TextColor="{StaticResource TextColorPrimary}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />

                        <!-- Total Final -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total a Pagar en Caja" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextColorPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding TotalFormateado}" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta 3: Método de Pago Preferente -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Método de Pago Preferente"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="{StaticResource TextColorPrimary}" />
                        
                        <Border Style="{StaticResource InputContainerStyle}" Padding="12,0">
                            <Picker ItemsSource="{Binding MetodosPago}"
                                    SelectedItem="{Binding MetodoPagoSeleccionado, Mode=TwoWay}"
                                    Title="Selecciona una forma de pago"
                                    TextColor="{StaticResource TextColorPrimary}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta 4: Notas o Indicaciones Especiales -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Indicaciones Adicionales (Opcional)"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{StaticResource TextColorPrimary}" />

                        <Border Style="{StaticResource InputContainerStyle}" HeightRequest="80" Padding="12,8">
                            <Editor Text="{Binding Notas, Mode=TwoWay}"
                                    Placeholder="Ej: Cabello teñido previamente, preferencia de diseño..."
                                    PlaceholderColor="{StaticResource TextColorSecondary}"
                                    FontSize="13"
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Banner de Error si ocurre conflicto -->
                <Border IsVisible="{Binding HasErrorMessage}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FDEDEC"
                        Stroke="{StaticResource ErrorColor}"
                        Padding="14,10">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource ErrorColor}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra Inferior Fija de Acción -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 0"
                Stroke="{StaticResource BorderColor}"
                BackgroundColor="{StaticResource SurfaceColor}"
                Padding="20,12">
            <VerticalStackLayout Spacing="8">
                <Button Text="Confirmar y Agendar Reserva"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ConfirmarReservaCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
