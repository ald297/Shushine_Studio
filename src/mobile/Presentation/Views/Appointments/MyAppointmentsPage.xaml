<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Appointments"
             xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Appointments.MyAppointmentsPage"
             x:DataType="vm:MyAppointmentsViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Mis Citas">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCitasCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">
                
                <Label Text="Tus Reservaciones"
                       Style="{StaticResource HeaderLabelStyle}" />

                <!-- Sección: Citas Próximas -->
                <Label Text="Próximas Citas" 
                       FontAttributes="Bold" 
                       FontSize="16" 
                       TextColor="{StaticResource PrimaryColor}" />

                <CollectionView ItemsSource="{Binding CitasProximas}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No tienes citas agendadas próximamente." 
                               TextColor="{StaticResource TextColorSecondary}" 
                               Padding="10" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Reserva">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" 
                                               Text="{Binding ServicioNombre}" 
                                               FontAttributes="Bold" 
                                               FontSize="16" />
                                        <Border Grid.Column="1" 
                                                StrokeShape="RoundRectangle 8" 
                                                BackgroundColor="{StaticResource SecondaryLight}" 
                                                Padding="8,4">
                                            <Label Text="{Binding Estado}" 
                                                   FontSize="11" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{StaticResource PrimaryDark}" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding EstilistaNombre, StringFormat='Atendido por: {0}'}" 
                                           FontSize="13" 
                                           TextColor="{StaticResource TextColorSecondary}" />
                                    <Label Text="{Binding FechaHoraInicio, StringFormat='📅 {0:dd/MM/yyyy - hh:mm tt}'}" 
                                           FontSize="13" 
                                           TextColor="{StaticResource TextColorPrimary}" />

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                        <Label Grid.Column="0" 
                                               Text="{Binding Total, StringFormat='Total: ${0:F2}'}" 
                                               FontAttributes="Bold" 
                                               TextColor="{StaticResource PrimaryColor}" 
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1" 
                                                Text="Cancelar Cita" 
                                                FontSize="12" 
                                                HeightRequest="36" 
                                                Padding="12,0" 
                                                BackgroundColor="{StaticResource ErrorColor}" 
                                                TextColor="White" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyAppointmentsViewModel}}, Path=CancelarCitaCommand}" 
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
