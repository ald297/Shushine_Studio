<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Booking"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Booking.BookingConfirmationPage"
             x:DataType="vm:BookingConfirmationViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="false">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22" VerticalOptions="Center">
            
            <!-- Icono Éxito y Felicitación -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,20,0,0">
                <Border StrokeShape="RoundRectangle 50" 
                        HeightRequest="90" 
                        WidthRequest="90"
                        Stroke="{StaticResource PrimaryColor}"
                        StrokeThickness="3"
                        BackgroundColor="{StaticResource SecondaryLight}"
                        HorizontalOptions="Center">
                    <Label Text="🎉" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="¡Reserva Confirmada!" 
                       Style="{StaticResource HeaderLabelStyle}" 
                       FontSize="24" 
                       HorizontalOptions="Center" />
                <Label Text="Tu cita ha sido agendada con éxito en Shushine Studio" 
                       FontSize="13" 
                       TextColor="{StaticResource TextColorSecondary}" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Comprobante Tipo Ticket (Wireframe Pág. 12) -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    
                    <!-- Código Único Alfanumérico -->
                    <Border StrokeShape="RoundRectangle 12" 
                            BackgroundColor="{StaticResource SecondaryLight}" 
                            Padding="14,10"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="CÓDIGO DE RESERVACIÓN" FontSize="10" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="{Binding Codigo}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,4" />

                    <!-- Detalles del Tratamiento -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tratamiento:" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                        <Label Text="{Binding ServicioNombre}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                    </VerticalStackLayout>

                    <!-- Profesional Asignado -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Profesional que te atenderá:" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                        <Label Text="{Binding EstilistaNombre}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                    </VerticalStackLayout>

                    <!-- Fecha y Horario -->
                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Fecha:" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                            <Label Text="{Binding Fecha, StringFormat='📅 {0}'}" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Horario:" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                            <Label Text="{Binding Hora, StringFormat='⏰ {0}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Sucursal -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sucursal:" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                        <Label Text="{Binding Sucursal}" FontSize="12" TextColor="{StaticResource TextColorPrimary}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,4" />

                    <!-- Total Estimado -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Monto total a cancelar en salón:" FontSize="12" TextColor="{StaticResource TextColorSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Total, StringFormat='${0}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,20">
                <Button Text="Ver en Mis Citas" 
                        Command="{Binding VerEnMisCitasCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Text="Volver al Inicio" 
                        Command="{Binding VolverAlInicioCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
