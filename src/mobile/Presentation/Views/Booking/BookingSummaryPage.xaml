<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Booking"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Booking.BookingSummaryPage"
             x:DataType="vm:BookingSummaryViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="{Binding Title}">

    <Grid RowDefinitions="*, Auto">
        
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="18">
                
                <Label Text="Revisa los detalles de tu cita" 
                       Style="{StaticResource HeaderLabelStyle}" 
                       FontSize="20" />
                <Label Text="Verifica que la fecha y el profesional sean los deseados antes de confirmar." 
                       Style="{StaticResource SubheaderLabelStyle}" 
                       FontSize="13" />

                <!-- Tarjeta Principal de Cita (Wireframe Pág. 11) -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        
                        <Label Text="Datos del Servicio" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource PrimaryDark}" />

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Border Grid.Column="0" 
                                    StrokeShape="RoundRectangle 12" 
                                    HeightRequest="55" 
                                    WidthRequest="55" 
                                    BackgroundColor="{StaticResource SecondaryLight}">
                                <Label Text="🌸" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Servicio.Nombre}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                                <Label Text="{Binding Servicio.DuracionMinutos, StringFormat='⏱ {0} minutos de atención'}" FontSize="12" TextColor="{StaticResource TextColorSecondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,4" />

                        <!-- Estilista, Fecha y Hora -->
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="10">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="Profesional" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                                <Label Text="{Binding EstilistaNombre}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                <Label Text="Horario" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                                <Label Text="{Binding Hora}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                <Label Text="Fecha Agendada" FontSize="11" TextColor="{StaticResource TextColorSecondary}" FontAttributes="Bold" />
                                <Label Text="{Binding Fecha, StringFormat='📅 {0}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Desglose Financiero de Costos -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Desglose de Pago en Salón" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextColorPrimary}" />

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Subtotal del servicio:" FontSize="13" TextColor="{StaticResource TextColorSecondary}" />
                            <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}" FontSize="13" FontAttributes="Bold" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Descuento membresía (10%):" FontSize="13" TextColor="{StaticResource PrimaryDark}" />
                            <Label Grid.Column="1" Text="{Binding Descuento, StringFormat='-${0:F2}'}" FontSize="13" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="IVA (13%):" FontSize="13" TextColor="{StaticResource TextColorSecondary}" />
                            <Label Grid.Column="1" Text="{Binding ImpuestoIva, StringFormat='${0:F2}'}" FontSize="13" FontAttributes="Bold" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,4" />

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total a pagar:" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding TotalPagar, StringFormat='${0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Alerta de Presentación -->
                <Border Style="{StaticResource CardBorderStyle}" BackgroundColor="{StaticResource SecondaryLight}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="⏰" FontSize="24" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Política de Asistencia" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="Por favor preséntate 5 minutos antes de tu cita en nuestra sucursal. Puedes cancelar sin penalización hasta 2 horas antes." 
                                   FontSize="12" 
                                   TextColor="{StaticResource TextColorPrimary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón Inferior Confirmar Cita -->
        <Border Grid.Row="1" 
                BackgroundColor="{StaticResource SurfaceColor}" 
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="20,12">
            <VerticalStackLayout Spacing="6">
                <Button Text="Confirmar Reserva ➔" 
                        Command="{Binding ConfirmarReservaCommand}" 
                        IsEnabled="{Binding IsBusy, Converter={x:Null}}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="20" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
