<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Booking"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Booking.BookingSummaryPage"
             x:DataType="vm:BookingSummaryViewModel"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="false">

    <Grid RowDefinitions="*, Auto">
        
        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16, 12, 16, 24" Spacing="16">
                
                <!-- Barra Superior de Navegación con Botón Atrás y Paso -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0, 4, 0, 4">
                    <!-- Botón Atrás Circular -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource Surface}"
                            WidthRequest="40"
                            HeightRequest="40"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VolverCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Título de Pantalla -->
                    <Label Grid.Column="1"
                           Text="Confirmar Cita"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <!-- Indicador de Paso -->
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource Surface}"
                            Padding="10, 4"
                            VerticalOptions="Center">
                        <Label Text="Paso 4 de 4"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                    </Border>
                </Grid>

                <!-- Título y Subtítulo de Sección -->
                <VerticalStackLayout Spacing="3">
                    <Label Text="Revisa los detalles de tu cita" 
                           Style="{StaticResource TitleLabelStyle}" 
                           FontSize="19" />
                    <Label Text="Verifica que el tratamiento, fecha y profesional sean los correctos antes de confirmar." 
                           Style="{StaticResource CaptionLabelStyle}" 
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Tarjeta Principal con Datos de la Cita (Ticket Preview) -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        
                        <!-- Header del Servicio -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Border Grid.Column="0" 
                                    StrokeShape="RoundRectangle 14" 
                                    HeightRequest="52" 
                                    WidthRequest="52" 
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource SecondaryLight}">
                                <Label Text="🌸" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="TRATAMIENTO SELECCIONADO" 
                                       FontSize="10" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Secondary}" />
                                <Label Text="{Binding Servicio.Nombre}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Servicio.DuracionFormateada, StringFormat='⏱ {0} de atención'}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0, 2" />

                        <!-- Cuadrícula de Estilista, Fecha y Horario -->
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12">
                            <!-- Profesional -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="PROFESIONAL" 
                                       FontSize="10" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       FontAttributes="Bold" />
                                <Label Text="{Binding EstilistaNombre}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>

                            <!-- Horario -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                <Label Text="HORARIO" 
                                       FontSize="10" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Hora}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                            <!-- Fecha -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <Label Text="FECHA AGENDADA" 
                                       FontSize="10" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Fecha, StringFormat='📅 {0}'}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>

                            <!-- Duración del Servicio -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="DURACIÓN ESTIMADA" 
                                       FontSize="10" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Servicio.DuracionFormateada}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Resumen de Inversión / Total Real -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Importe de la Reserva" 
                               FontAttributes="Bold" 
                               FontSize="15" 
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- Detalle del Tratamiento -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   Text="{Binding Servicio.Nombre}" 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextSecondary}" 
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1" 
                                   Text="{Binding TotalPagarFormateado}" 
                                   FontSize="13" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0, 2" />

                        <!-- Total Final -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Total a pagar:" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Cancelación directa en salón" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" 
                                   Text="{Binding TotalPagarFormateado}" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Banner de Error si Ocurre -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource StatusCanceladaBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource StatusCanceladaBg}"
                        Padding="14, 10"
                        IsVisible="{Binding HasErrorMessage}">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="12"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra Inferior Fija de Confirmación -->
        <Border Grid.Row="1" 
                BackgroundColor="{StaticResource Surface}" 
                StrokeThickness="1"
                Stroke="{StaticResource Border}"
                Padding="20, 14">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                    <Label Text="Total a cancelar:" 
                           Style="{StaticResource CaptionLabelStyle}" 
                           TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding TotalPagarFormateado}" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Button Text="Confirmar Reserva ➔" 
                            Command="{Binding ConfirmarReservaCommand}" 
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="48"
                            Padding="22, 0"
                            FontSize="15" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       IsVisible="{Binding IsBusy}" 
                                       Color="{StaticResource Primary}" 
                                       HeightRequest="18" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
