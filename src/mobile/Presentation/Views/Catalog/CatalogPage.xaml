<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Catalog"
             xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Catalog.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Servicios de Belleza">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        
        <!-- 1. Cabecera de Bienvenida -->
        <VerticalStackLayout Grid.Row="0" Padding="20,12,20,4" Spacing="4">
            <Label Text="Shushine Studio"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}" />
            <Label Text="Nuestros Tratamientos"
                   Style="{StaticResource HeaderLabelStyle}"
                   FontSize="24" />
            <Label Text="Elige tu servicio favorito y agenda tu cita al instante"
                   Style="{StaticResource SubheaderLabelStyle}"
                   FontSize="13" />
        </VerticalStackLayout>

        <!-- 2. Barra de Búsqueda de Tratamientos (US-3.01 / Wireframe Pág. 7) -->
        <Border Grid.Row="1" 
                Style="{StaticResource InputContainerStyle}" 
                Margin="20,8,20,6"
                Padding="8,0">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" Margin="4,0,8,0" />
                <Entry Grid.Column="1"
                       Placeholder="Buscar tinte, manicura, corte..."
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing" />
            </Grid>
        </Border>

        <!-- 3. Selector Horizontal de Categorías (Chips) -->
        <ScrollView Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalScrollBarVisibility="Never" 
                    Padding="20,6,20,8">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Categorias}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="{StaticResource PrimaryColor}"
                                BackgroundColor="{StaticResource SurfaceColor}"
                                Padding="14,6">
                            <Label Text="{Binding .}" 
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=FilterByCategoriaCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 4. Listado de Servicios en CollectionView -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadServiciosCommand}">
            <CollectionView ItemsSource="{Binding Servicios}"
                            SelectionMode="None"
                            Margin="20,0,20,10">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="10" VerticalOptions="Center">
                        <Label Text="✨" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No encontramos servicios con ese criterio."
                               HorizontalOptions="Center"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Label Text="Intenta seleccionar otra categoría o cambiar tu búsqueda."
                               HorizontalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource TextColorSecondary}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Servicio">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <Grid ColumnDefinitions="95, *" Padding="12" ColumnSpacing="12">
                                
                                <!-- Icono / Foto del Tratamiento -->
                                <Border Grid.Column="0" 
                                        StrokeShape="RoundRectangle 12" 
                                        HeightRequest="90" 
                                        WidthRequest="90"
                                        BackgroundColor="{StaticResource SecondaryLight}">
                                    <Label Text="✨" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <!-- Información del Servicio -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding CategoriaNombre}" 
                                           FontSize="11" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource PrimaryColor}" />
                                    <Label Text="{Binding Nombre}" 
                                           FontSize="15" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource TextColorPrimary}" 
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Descripcion}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource TextColorSecondary}" 
                                           MaxLines="2" 
                                           LineBreakMode="TailTruncation" />

                                    <!-- Precio, Duración y Botón Seleccionar -->
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                                            <Label Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{StaticResource PrimaryDark}" />
                                            <Label Text="{Binding DuracionMinutos, StringFormat='⏱ {0} min'}" 
                                                   FontSize="12" 
                                                   TextColor="{StaticResource TextColorSecondary}" 
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Border Grid.Column="1" 
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                Padding="10,4">
                                            <Label Text="Reservar ➔" 
                                                   TextColor="White" 
                                                   FontSize="11" 
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

                            </Grid>
                            
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=SelectServicioCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
