<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Catalog"
             xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Catalog.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="false">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        
        <!-- 1. Cabecera Oficial de Bienvenida (Wireframe Pág. 7) -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,6" Spacing="3">
            <Label Text="Shushine Studio"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}" />
            <Label Text="Nuestros Tratamientos"
                   Style="{StaticResource HeaderLabelStyle}"
                   FontSize="24" />
            <Label Text="Elige tu servicio favorito y agenda tu cita al instante"
                   Style="{StaticResource SubheaderLabelStyle}"
                   FontSize="12" />
        </VerticalStackLayout>

        <!-- 2. Barra de Búsqueda de Tratamientos (Wireframe Pág. 7) -->
        <Border Grid.Row="1" 
                Style="{StaticResource InputContainerStyle}" 
                Margin="20,6,20,6"
                Padding="12,0"
                HeightRequest="46">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0" />
                <Entry Grid.Column="1"
                       Placeholder="Buscar tinte, manicura, corte..."
                       PlaceholderColor="{StaticResource TextColorSecondary}"
                       Text="{Binding SearchText}"
                       FontSize="14"
                       ClearButtonVisibility="WhileEditing"
                       BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <!-- 3. Selector Horizontal de Categorías (Chips con Cambio de Color Activo) -->
        <ScrollView Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalScrollBarVisibility="Never" 
                    Padding="20,6,20,10">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Categorias}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoriaItem">
                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="{StaticResource PrimaryColor}"
                                StrokeThickness="1"
                                Padding="14,8">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Icono}" FontSize="13" VerticalOptions="Center" />
                                <Label Text="{Binding Nombre}" 
                                       FontSize="13"
                                       FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource TextColorPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=SeleccionarCategoriaCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 4. Listado de Servicios en CollectionView -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadServiciosCommand}">
            <CollectionView ItemsSource="{Binding Servicios}"
                            SelectionMode="None"
                            Margin="20,0,20,10">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="10" VerticalOptions="Center">
                        <Label Text="✨" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No encontramos servicios con ese criterio."
                               HorizontalOptions="Center"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Label Text="Intenta seleccionar otra categoría o cambiar tu búsqueda."
                               HorizontalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource TextColorSecondary}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Servicio">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0, 0, 0, 2" Padding="0">
                            <Grid ColumnDefinitions="95, *" Padding="12" ColumnSpacing="12">
                                
                                <!-- Icono o Imagen del Tratamiento -->
                                <Border Grid.Column="0" 
                                        StrokeShape="RoundRectangle 12" 
                                        HeightRequest="90" 
                                        WidthRequest="90"
                                        BackgroundColor="{StaticResource SecondaryLight}">
                                    <Grid>
                                        <Image Source="{Binding ImagenUrl}" 
                                               Aspect="AspectFill" 
                                               IsVisible="{Binding TieneImagen}" />
                                        <Label Text="✨" FontSize="34" 
                                               HorizontalOptions="Center" VerticalOptions="Center" 
                                               IsVisible="{Binding NoTieneImagen}" />
                                    </Grid>
                                </Border>

                                <!-- Información del Servicio -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding CategoriaNombre}" 
                                           FontSize="11" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource PrimaryColor}" />
                                    <Label Text="{Binding Nombre}" 
                                           FontSize="15" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource TextColorPrimary}" 
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Descripcion}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource TextColorSecondary}" 
                                           MaxLines="2" 
                                           LineBreakMode="TailTruncation" />

                                    <!-- Precio, Duración y Botón Reservar -->
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                                            <Label Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{StaticResource PrimaryDark}" />
                                            <Label Text="{Binding DuracionMinutos, StringFormat='⏱ {0} min'}" 
                                                   FontSize="12" 
                                                   TextColor="{StaticResource TextColorSecondary}" 
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Border Grid.Column="1" 
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                Padding="12,6">
                                            <Label Text="Reservar ➔" 
                                                   TextColor="White" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

                            </Grid>
                            
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}, Path=SelectServicioCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
