<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Reviews"
    xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Reviews.MyReviewsPage"
    x:DataType="vm:MyReviewsViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Mis Reseñas">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
            <Grid ColumnDefinitions="44,*,44">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.png"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Mis Reseñas"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView HeightRequest="2" WidthRequest="40"
                             BackgroundColor="{StaticResource Secondary}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
        </Grid>

        <!-- CUERPO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="24">

                <!-- INTRODUCCIÓN -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Experiencias Shunshine"
                        FontFamily="PlusJakartaSans"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Secondary}"
                        CharacterSpacing="1" />
                    <Label
                        Text="Tus Valoraciones y Testimonios"
                        FontFamily="PlayfairDisplay"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />
                    <Label
                        Text="Consulta las reseñas que has otorgado a tus tratamientos o califica tus citas completadas recientemente."
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- CITAS PENDIENTES DE VALORACIÓN (SI EXISTEN EN BACKEND) -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding TieneCitasPendientes}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Pendientes de Calificar"
                            FontFamily="PlayfairDisplay"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding CitasPendientesCalificar.Count, StringFormat='{0} citas'}"
                            FontFamily="PlusJakartaSans"
                            FontSize="12"
                            TextColor="{StaticResource Secondary}"
                            FontAttributes="Bold" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding CitasPendientesCalificar}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:Reserva">
                                <Frame
                                    BackgroundColor="{StaticResource Surface}"
                                    BorderColor="{StaticResource Secondary}"
                                    CornerRadius="16"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    HasShadow="False">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding CodigoReserva}"
                                                FontFamily="PlusJakartaSans"
                                                FontSize="11"
                                                TextColor="{StaticResource Secondary}"
                                                FontAttributes="Bold" />
                                            <Frame
                                                Grid.Column="1"
                                                BackgroundColor="#E8F5E9"
                                                BorderColor="#A5D6A7"
                                                CornerRadius="8"
                                                Padding="6,2"
                                                HasShadow="False">
                                                <Label
                                                    Text="Completada"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#2E7D32" />
                                            </Frame>
                                        </Grid>

                                        <Label
                                            Text="{Binding ServicioNombre}"
                                            FontFamily="PlayfairDisplay"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Primary}" />

                                        <Label
                                            Text="{Binding EstilistaNombre, StringFormat='Atendida por {0}'}"
                                            FontFamily="PlusJakartaSans"
                                            FontSize="12"
                                            TextColor="{StaticResource TextSecondary}" />

                                        <Button
                                            Text="Calificar Servicio"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyReviewsViewModel}}, Path=IrACalificarCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HeightRequest="42"
                                            FontSize="13"
                                            CornerRadius="10"
                                            Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- SECCIÓN HISTORIAL DE RESEÑAS -->
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Historial Publicado"
                        FontFamily="PlayfairDisplay"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <!-- LISTA REAL DE RESEÑAS PUBLICADAS -->
                    <CollectionView
                        ItemsSource="{Binding ResenasPublicadas}"
                        IsVisible="{Binding TieneResenasPublicadas}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:Resena">
                                <Frame
                                    BackgroundColor="{StaticResource Surface}"
                                    BorderColor="{StaticResource Border}"
                                    CornerRadius="16"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    HasShadow="False">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label
                                                Text="{Binding ServicioNombre}"
                                                FontFamily="PlayfairDisplay"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding FechaFormateada}"
                                                FontFamily="PlusJakartaSans"
                                                FontSize="11"
                                                TextColor="{StaticResource TextSecondary}" />
                                        </Grid>

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding EstrellasTexto}"
                                                FontSize="16"
                                                TextColor="#F59E0B" />
                                            <Label
                                                Text="{Binding NivelTexto}"
                                                FontFamily="PlusJakartaSans"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Label
                                            Text="{Binding Comentario}"
                                            FontFamily="PlusJakartaSans"
                                            FontSize="13"
                                            TextColor="{StaticResource TextPrimary}"
                                            LineHeight="1.3" />

                                        <Label
                                            Text="{Binding EstilistaNombre, StringFormat='Atendida por {0}'}"
                                            FontFamily="PlusJakartaSans"
                                            FontSize="11"
                                            TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ESTADO VACÍO CUANDO NO HAY RESEÑAS -->
                    <Frame
                        IsVisible="{Binding NoTieneResenasPublicadas}"
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="16"
                        Padding="24,28"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Label
                                Text="⭐"
                                FontSize="40"
                                HorizontalOptions="Center" />

                            <Label
                                Text="Sin Reseñas Publicadas"
                                FontFamily="PlayfairDisplay"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Tus valoraciones y testimonios aparecerán listados aquí una vez califiques tus citas completadas."
                                FontFamily="PlusJakartaSans"
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalTextAlignment="Center"
                                LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
