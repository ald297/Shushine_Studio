<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Reviews"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Reviews.LeaveReviewPage"
    x:DataType="vm:LeaveReviewViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Calificar Servicio">

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- HEADER -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
                <Grid ColumnDefinitions="44,*,44">
                    <ImageButton
                        Grid.Column="0"
                        Source="arrow_left.svg"
                        Command="{Binding RegresarCommand}"
                        WidthRequest="28" HeightRequest="28"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <Label
                            Text="Calificar Servicio"
                            FontFamily="PlayfairDisplay"
                            FontSize="18" FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalOptions="Center" />
                        <BoxView HeightRequest="2" WidthRequest="40"
                                 BackgroundColor="{StaticResource Secondary}"
                                 HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
            </Grid>

            <!-- CUERPO DESPLAZABLE -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,20,20,24" Spacing="20">

                    <!-- TARJETA: CITA COMPLETADA -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="16"
                        Padding="16"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="CITA TERMINADA"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Secondary}"
                                    CharacterSpacing="1" />
                                <Frame
                                    Grid.Column="1"
                                    BackgroundColor="#E8F5E9"
                                    BorderColor="#A5D6A7"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    HasShadow="False">
                                    <Label
                                        Text="Completada"
                                        FontFamily="PlusJakartaSans"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="#2E7D32" />
                                </Frame>
                            </Grid>

                            <Label
                                Text="{Binding ServicioNombre}"
                                FontFamily="PlayfairDisplay"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="👤" FontSize="14" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding EstilistaNombre, StringFormat='Atendido por {0}'}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="📅" FontSize="14" VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding FechaTexto}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- BANNER INFORMATIVO: ESTADO BACKEND -->

                    <!-- SECCIÓN: SELECTOR DE ESTRELLAS -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="16"
                        Padding="20,18"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                            <Label
                                Text="¿Cómo fue tu experiencia?"
                                FontFamily="PlayfairDisplay"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Tu testimonio ayuda a nuestras especialistas y guía a otras clientas del atelier."
                                FontFamily="PlusJakartaSans"
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalTextAlignment="Center" />

                            <!-- BOTONES DE 1 A 5 ESTRELLAS -->
                            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Button Text="1 ★"
                                        Command="{Binding SeleccionarEstrellasCommand}"
                                        CommandParameter="1"
                                        FontSize="14" HeightRequest="44" CornerRadius="12"
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        TextColor="{StaticResource TextPrimary}" />
                                <Button Text="2 ★"
                                        Command="{Binding SeleccionarEstrellasCommand}"
                                        CommandParameter="2"
                                        FontSize="14" HeightRequest="44" CornerRadius="12"
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        TextColor="{StaticResource TextPrimary}" />
                                <Button Text="3 ★"
                                        Command="{Binding SeleccionarEstrellasCommand}"
                                        CommandParameter="3"
                                        FontSize="14" HeightRequest="44" CornerRadius="12"
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        TextColor="{StaticResource TextPrimary}" />
                                <Button Text="4 ★"
                                        Command="{Binding SeleccionarEstrellasCommand}"
                                        CommandParameter="4"
                                        FontSize="14" HeightRequest="44" CornerRadius="12"
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        TextColor="{StaticResource TextPrimary}" />
                                <Button Text="5 ★"
                                        Command="{Binding SeleccionarEstrellasCommand}"
                                        CommandParameter="5"
                                        FontSize="14" HeightRequest="44" CornerRadius="12"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="{StaticResource Surface}" />
                            </HorizontalStackLayout>

                            <!-- BADGE Y CITA DINÁMICA -->
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Frame
                                    BackgroundColor="{StaticResource Secondary}"
                                    CornerRadius="12"
                                    Padding="14,6"
                                    HasShadow="False"
                                    HorizontalOptions="Center">
                                    <Label
                                        Text="{Binding NivelFeedback}"
                                        FontFamily="PlusJakartaSans"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Surface}" />
                                </Frame>

                                <Label
                                    Text="{Binding FraseFeedback, StringFormat='&quot;{0}&quot;'}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    FontAttributes="Italic"
                                    TextColor="{StaticResource Primary}"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- ERROR DE FORMULARIO -->
                    <Frame IsVisible="{Binding HasError}"
                           BackgroundColor="#FFEBEE" BorderColor="#FFCDD2"
                           CornerRadius="10" Padding="14,10" HasShadow="False">
                        <Label Text="{Binding ErrorMessage}"
                               FontFamily="PlusJakartaSans" FontSize="13"
                               TextColor="#C62828" />
                    </Frame>

                    <!-- SECCIÓN: COMENTARIO -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Cuéntanos tu experiencia"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1"
                                   Text="(Opcional)"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </Grid>

                        <Frame
                            BackgroundColor="{StaticResource Surface}"
                            BorderColor="{StaticResource Border}"
                            CornerRadius="14"
                            Padding="14"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <Editor
                                    Text="{Binding Comentario}"
                                    Placeholder="Describe los detalles de tu atención, el trato recibido o los resultados de tu estilo..."
                                    PlaceholderColor="{StaticResource TextSecondary}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    TextColor="{StaticResource TextPrimary}"
                                    HeightRequest="100"
                                    MaxLength="500" />
                                <Label
                                    Text="{Binding ContadorCaracteres}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="11"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- PERMISO DE PUBLICACIÓN -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="16,12"
                        HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Publicar testimonio en catálogo"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Text="Tu nombre aparecerá como referencia junto al servicio."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="11"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding VisiblePublica}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{StaticResource Surface}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

            <!-- BOTONES DE ACCIÓN FIJOS -->
            <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}" Padding="20,14,20,24">
                <VerticalStackLayout Spacing="10">
                    <Button
                        Text="Enviar Reseña"
                        Command="{Binding EnviarResenaCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="50"
                        FontSize="15"
                        CornerRadius="14" />

                    <Button
                        Text="Ahora no (Dejar para después)"
                        Command="{Binding AbrirModalPosponerCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Secondary}"
                        FontSize="13"
                        FontFamily="PlusJakartaSans"
                        FontAttributes="Bold"
                        HeightRequest="40" />
                </VerticalStackLayout>
            </Grid>

        </Grid>

        <!-- MODAL: DEJAR PARA DESPUÉS -->
        <Grid IsVisible="{Binding MostrarModalPosponer}"
              BackgroundColor="#88000000"
              Padding="24">
            <Frame
                BackgroundColor="{StaticResource Surface}"
                BorderColor="{StaticResource Border}"
                CornerRadius="20"
                Padding="24"
                VerticalOptions="Center"
                HasShadow="True">
                <VerticalStackLayout Spacing="16">
                    <Label
                        Text="¿Deseas valorar después?"
                        FontFamily="PlayfairDisplay"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Podrás calificar tu experiencia en cualquier momento desde tu historial de citas o desde tu perfil."
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />

                    <Button
                        Text="Entendido, volver más tarde"
                        Command="{Binding ConfirmarPosponerCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="46"
                        FontSize="14"
                        CornerRadius="12" />

                    <Button
                        Text="Continuar escribiendo"
                        Command="{Binding CerrarModalPosponerCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        FontSize="13"
                        FontFamily="PlusJakartaSans"
                        FontAttributes="Bold"
                        HeightRequest="40" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
