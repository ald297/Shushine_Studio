<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Reviews"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Reviews.ReviewDetailPage"
    x:DataType="vm:ReviewDetailViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Detalle de Reseña">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
            <Grid ColumnDefinitions="44,*,44">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.svg"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Detalle de Reseña"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView HeightRequest="2" WidthRequest="40"
                             BackgroundColor="{StaticResource Secondary}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
        </Grid>

        <!-- CUERPO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="20">

                <!-- DETALLE DE LA RESEÑA -->
                <Frame
                    BackgroundColor="{StaticResource Surface}"
                    BorderColor="{StaticResource Border}"
                    CornerRadius="16"
                    Padding="18"
                    HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="{Binding Resena.ServicioNombre, FallbackValue='Servicio del Atelier'}"
                            FontFamily="PlayfairDisplay"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}" />

                        <Label
                            Text="{Binding Resena.EstilistaNombre, FallbackValue='Especialista asignada', StringFormat='Profesional: {0}'}"
                            FontFamily="PlusJakartaSans"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}" />

                        <Label
                            Text="{Binding Resena.EstrellasTexto, FallbackValue='★★★★★'}"
                            FontSize="22"
                            TextColor="{StaticResource Secondary}" />

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,4" />

                        <Label
                            Text="Comentario registrado:"
                            FontFamily="PlusJakartaSans"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}" />

                        <Label
                            Text="{Binding Comentario}"
                            FontFamily="PlusJakartaSans"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"
                            LineHeight="1.4" />

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,4" />

                        <Label
                            Text="{Binding Resena.FechaFormateada, StringFormat='Publicada el: {0}'}"
                            FontFamily="PlusJakartaSans"
                            FontSize="11"
                            TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTÓN -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}" Padding="20,14,20,24">
            <Button
                Text="Volver a Mis Reseñas"
                Command="{Binding RegresarCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HeightRequest="48"
                FontSize="14"
                CornerRadius="12" />
        </Grid>

    </Grid>
</ContentPage>
