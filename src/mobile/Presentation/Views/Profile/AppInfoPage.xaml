<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Profile"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Profile.AppInfoPage"
    x:DataType="vm:AppInfoViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Información de la App">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
            <Grid ColumnDefinitions="44,*,44">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.png"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Información"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView HeightRequest="2" WidthRequest="40"
                             BackgroundColor="{StaticResource Secondary}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
        </Grid>

        <!-- CUERPO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,28,20,40" Spacing="24">

                <!-- LOGO & BRANDING HERO -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Frame
                        WidthRequest="88" HeightRequest="88"
                        CornerRadius="44"
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Secondary}"
                        Padding="0"
                        HasShadow="True">
                        <Label
                            Text="✨"
                            FontSize="38"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Frame>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label
                            Text="SHUNSHINE STUDIO"
                            FontFamily="PlayfairDisplay"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalTextAlignment="Center"
                            CharacterSpacing="1.5" />
                        <Label
                            Text="Salón de Belleza &amp; Estética Integral"
                            FontFamily="PlusJakartaSans"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalTextAlignment="Center" />
                        <Frame
                            BackgroundColor="#F7F3EE"
                            BorderColor="{StaticResource Secondary}"
                            CornerRadius="12"
                            Padding="12,4"
                            HorizontalOptions="Center"
                            Margin="0,6,0,0"
                            HasShadow="False">
                            <Label
                                Text="{Binding AppVersion, StringFormat='Versión {0}'}"
                                FontFamily="PlusJakartaSans"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- DETALLES DEL SALÓN -->
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Sobre el Salón"
                        FontFamily="PlayfairDisplay"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="18,16"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="14">
                            <!-- Ubicación -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="📍" FontSize="18" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Ubicación" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding SalonAddress}" FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                            <!-- Horarios -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="🕒" FontSize="18" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Horarios de Atención" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding HorarioAtencion}" FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                            <!-- Institución & Proyecto -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="🎓" FontSize="18" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Proyecto Académico" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Institucion}" FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                                    <Label Text="{Binding Equipo}" FontFamily="PlusJakartaSans" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- LEGAL Y CONDICIONES -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Términos y Políticas"
                        FontFamily="PlayfairDisplay"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <!-- Términos -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="0"
                        HasShadow="False">
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VerTerminosCommand}" />
                            </Grid.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                <Label Grid.Column="0" Text="📜" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                                <Label Grid.Column="1" Text="Términos del Servicio" FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Frame>

                    <!-- Privacidad -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="0"
                        HasShadow="False">
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VerPrivacidadCommand}" />
                            </Grid.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                <Label Grid.Column="0" Text="🛡️" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                                <Label Grid.Column="1" Text="Política de Privacidad" FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- DERECHOS RESERVADOS -->
                <Label
                    Text="© 2026 Shunshine Studio. Todos los derechos reservados."
                    FontFamily="PlusJakartaSans"
                    FontSize="11"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center"
                    Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
