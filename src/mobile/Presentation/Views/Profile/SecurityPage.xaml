<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Profile"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Profile.SecurityPage"
    x:DataType="vm:SecurityViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Seguridad">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
            <Grid ColumnDefinitions="44,*,44">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.png"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Seguridad"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView HeightRequest="2" WidthRequest="40"
                             BackgroundColor="{StaticResource Secondary}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
        </Grid>

        <!-- CUERPO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24,20,24" Spacing="20">



                <!-- Título de sección -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Cambiar contraseña"
                           FontFamily="PlayfairDisplay"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Completa los campos para cambiar tu contraseña de acceso."
                           FontFamily="PlusJakartaSans"
                           FontSize="14" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Error -->
                <Frame IsVisible="{Binding HasError}"
                       BackgroundColor="#FFEBEE" BorderColor="#FFCDD2"
                       CornerRadius="10" Padding="14,10" HasShadow="False">
                    <Label Text="{Binding ErrorMessage}"
                           FontFamily="PlusJakartaSans" FontSize="13"
                           TextColor="#C62828" />
                </Frame>

                <!-- Contraseña actual -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Contraseña actual"
                           FontFamily="PlusJakartaSans" FontSize="13"
                           FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Frame BackgroundColor="{StaticResource InputBackground}"
                           BorderColor="{StaticResource Border}"
                           CornerRadius="12" Padding="16,0" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding ContrasenaActual}"
                                   IsPassword="{Binding MostrarContrasenaActual, Converter={x:Null}}"
                                   Placeholder="••••••••"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   FontFamily="PlusJakartaSans" FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   HeightRequest="48" />
                            <ImageButton Grid.Column="1"
                                         Source="eye.png"
                                         Command="{Binding ToggleMostrarActualCommand}"
                                         WidthRequest="20" HeightRequest="20"
                                         BackgroundColor="Transparent" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- Nueva contraseña -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nueva contraseña"
                           FontFamily="PlusJakartaSans" FontSize="13"
                           FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Frame BackgroundColor="{StaticResource InputBackground}"
                           BorderColor="{StaticResource Border}"
                           CornerRadius="12" Padding="16,0" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding ContrasenaNueva}"
                                   IsPassword="{Binding MostrarContrasenaNueva, Converter={x:Null}}"
                                   Placeholder="Mín. 8 caracteres"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   FontFamily="PlusJakartaSans" FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   HeightRequest="48" />
                            <ImageButton Grid.Column="1"
                                         Source="eye.png"
                                         Command="{Binding ToggleMostrarNuevaCommand}"
                                         WidthRequest="20" HeightRequest="20"
                                         BackgroundColor="Transparent" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- Confirmar contraseña -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Confirmar nueva contraseña"
                           FontFamily="PlusJakartaSans" FontSize="13"
                           FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Frame BackgroundColor="{StaticResource InputBackground}"
                           BorderColor="{StaticResource Border}"
                           CornerRadius="12" Padding="16,0" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding ContrasenaConfirmar}"
                                   IsPassword="{Binding MostrarContrasenaConfirmar, Converter={x:Null}}"
                                   Placeholder="Repite la nueva contraseña"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   FontFamily="PlusJakartaSans" FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   HeightRequest="48" />
                            <ImageButton Grid.Column="1"
                                         Source="eye.png"
                                         Command="{Binding ToggleMostrarConfirmarCommand}"
                                         WidthRequest="20" HeightRequest="20"
                                         BackgroundColor="Transparent" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTÓN -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}" Padding="20,12,20,32">
            <Button
                Text="Cambiar contraseña"
                Command="{Binding CambiarContrasenaCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource TextLight}"
                FontFamily="PlusJakartaSans" FontAttributes="Bold"
                FontSize="16" CornerRadius="12" HeightRequest="52" />
        </Grid>

    </Grid>
</ContentPage>
