<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Profile"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Profile.PreferencesPage"
    x:DataType="vm:PreferencesViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Preferencias">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
            <Grid ColumnDefinitions="44,*,44">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.svg"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Preferencias"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView HeightRequest="2" WidthRequest="40"
                             BackgroundColor="{StaticResource Secondary}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
        </Grid>

        <!-- CUERPO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

                <!-- Banner Informativo: Preferencias locales -->
                <Frame
                    BackgroundColor="#F3F0EC"
                    BorderColor="{StaticResource Border}"
                    CornerRadius="12"
                    Padding="16,14"
                    HasShadow="False">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="ℹ️" FontSize="16" Margin="0,0,8,0" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Ajustes locales del dispositivo"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label
                            Text="Estas configuraciones se almacenan directamente en tu teléfono para personalizar las notificaciones y alertas locales."
                            FontFamily="PlusJakartaSans"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}"
                            LineHeight="1.3" />
                    </VerticalStackLayout>
                </Frame>

                <!-- SECCIÓN: NOTIFICACIONES DE CITAS -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Citas y Recordatorios"
                        FontFamily="PlayfairDisplay"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <!-- Recordatorios de citas -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="16,14"
                        HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label
                                    Text="Recordatorios de Citas"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Text="Notificaciones preventivas 24h y 2h antes de tu cita programada."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding RecordatoriosCita}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{StaticResource Surface}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <!-- Cambios de estado en citas -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="16,14"
                        HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label
                                    Text="Actualizaciones de Citas"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Text="Avisos sobre confirmaciones, cancelaciones o reprogramaciones."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding CambiosDeCita}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{StaticResource Surface}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- SECCIÓN: COMUNICACIÓN Y MENSAJES -->
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Comunicación"
                        FontFamily="PlayfairDisplay"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <!-- Mensajes de chat -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="16,14"
                        HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label
                                    Text="Mensajes del Salón"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Text="Alertas sonoras y emergentes al recibir respuestas del administrador."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding MensajesChat}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{StaticResource Surface}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <!-- Promociones y novedades -->
                    <Frame
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="14"
                        Padding="16,14"
                        HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label
                                    Text="Promociones y Colecciones"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label
                                    Text="Nuevos lanzamientos de temporadas, productos y servicios destacados."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding PromocionesOfertas}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{StaticResource Surface}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
