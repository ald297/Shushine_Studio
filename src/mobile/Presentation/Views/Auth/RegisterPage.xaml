<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Auth"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            
            <Label Text="Crear Cuenta"
                   Style="{StaticResource HeaderLabelStyle}"
                   FontSize="26" />
            <Label Text="Completa tus datos para agendar citas y obtener descuentos exclusivos."
                   TextColor="{StaticResource TextColorSecondary}" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    
                    <!-- Nombre Completo -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre y Apellidos" FontSize="13" TextColor="{StaticResource TextColorSecondary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="Camila Calderón"
                                   Text="{Binding Nombre}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Correo -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo Electrónico" FontSize="13" TextColor="{StaticResource TextColorSecondary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="ejemplo@correo.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Teléfono -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Teléfono / WhatsApp" FontSize="13" TextColor="{StaticResource TextColorSecondary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="+503 7000-0000"
                                   Text="{Binding Telefono}"
                                   Keyboard="Telephone" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Contraseña -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña" FontSize="13" TextColor="{StaticResource TextColorSecondary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="Mínimo 8 caracteres"
                                   Text="{Binding Password}"
                                   IsPassword="true" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botón Registrarse -->
                    <Button Text="Crear mi Cuenta"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,15,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>

            <!-- Volver -->
            <Button Text="¿Ya tienes cuenta? Inicia Sesión"
                    Command="{Binding NavigateBackToLoginCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
