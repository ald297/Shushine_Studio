<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Auth"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="true"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            
            <!-- Cabecera de Registro -->
            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                <Label Text="Crear Cuenta"
                       Style="{StaticResource HeaderLabelStyle}"
                       FontSize="28" />
                <Label Text="Únete a la experiencia de Shushine Studio y reserva tus tratamientos favoritos."
                       Style="{StaticResource SubheaderLabelStyle}"
                       FontSize="14" />
            </VerticalStackLayout>

            <!-- Formulario de Registro en Tarjeta -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <VerticalStackLayout Spacing="14">
                    
                    <!-- Campo Nombre Completo -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre y Apellidos *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="ej. Camila Calderón"
                                   Text="{Binding Nombre}"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Correo Electrónico -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo Electrónico *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="ejemplo@correo.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Teléfono / WhatsApp -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Teléfono / WhatsApp" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="7000-0000"
                                   Text="{Binding Telefono}"
                                   Keyboard="Telephone"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña (mínimo 6 caracteres) *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="••••••••"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       ReturnType="Next" />
                                <ImageButton Grid.Column="1"
                                             Source="eye.png"
                                             Command="{Binding TogglePasswordVisibilityCommand}"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Confirmar Contraseña -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmar Contraseña *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="••••••••"
                                       Text="{Binding ConfirmPassword}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       ReturnType="Done" />
                                <ImageButton Grid.Column="1"
                                             Source="eye.png"
                                             Command="{Binding TogglePasswordVisibilityCommand}"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Checkbox de Términos y Condiciones -->
                    <HorizontalStackLayout Spacing="10" Margin="0,6,0,4" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding AcceptTerms}" 
                                  Color="{StaticResource PrimaryColor}" 
                                  VerticalOptions="Center" />
                        <Label Text="Acepto los Términos y Condiciones del Salón"
                               FontSize="12"
                               TextColor="{StaticResource TextColorSecondary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Botón Registrarse -->
                    <Button Text="Registrarse"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={x:Null}}"
                            Margin="0,10,0,0" />

                    <!-- Indicador de Carga Reactivo -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HeightRequest="30" />
                </VerticalStackLayout>
            </Border>

            <!-- Pie: Enlace de retorno al Login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,20">
                <Label Text="¿Ya tienes una cuenta?" 
                       TextColor="{StaticResource TextColorSecondary}" 
                       FontSize="14" />
                <Label Text="Inicia sesión aquí"
                       TextColor="{StaticResource PrimaryColor}"
                       FontAttributes="Bold"
                       FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateBackToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
