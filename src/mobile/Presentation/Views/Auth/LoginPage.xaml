<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Auth"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="false">

    <ScrollView>
        <Grid RowDefinitions="*, Auto" MinimumHeightRequest="680">
            <VerticalStackLayout Grid.Row="0" 
                                 Padding="32, 40, 32, 20" 
                                 Spacing="0" 
                                 VerticalOptions="Center">
                
                <!-- 1. Logotipo Oficial Flor de Loto Replicado -->
                <Image Source="shunshine_logo.png"
                       HeightRequest="115"
                       WidthRequest="145"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0, 10, 0, 14" />

                <!-- 2. Título Principal -->
                <Label Text="Shunshine Estudio"
                       FontSize="27"
                       FontFamily="Serif"
                       FontAttributes="Bold"
                       TextColor="#2C3E50"
                       HorizontalOptions="Center" />

                <!-- 3. Subtítulo en Mayúsculas Espaciadas -->
                <Label Text="BIENVENIDA DE NUEVO"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="2.5"
                       TextColor="#718096"
                       HorizontalOptions="Center"
                       Margin="0, 6, 0, 0" />

                <!-- 4. Barra Divisoria Rosa Suave (Paleta de Wireframes) -->
                <BoxView HeightRequest="3"
                         WidthRequest="46"
                         CornerRadius="2"
                         BackgroundColor="{StaticResource PrimaryColor}"
                         Opacity="0.65"
                         HorizontalOptions="Center"
                         Margin="0, 10, 0, 32" />

                <!-- 5. Campo: Correo Electrónico -->
                <Label Text="Correo electrónico"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#374151"
                       Margin="0, 0, 0, 8" />

                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        BackgroundColor="#F9FAFB"
                        StrokeShape="RoundRectangle 14"
                        Padding="14, 2"
                        Margin="0, 0, 0, 18">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="mail.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="ejemplo@correo.com"
                               PlaceholderColor="#9CA3AF"
                               Text="{Binding Email}"
                               TextColor="#1F2937"
                               Keyboard="Email"
                               FontSize="14"
                               HeightRequest="48"
                               VerticalOptions="Center"
                               BackgroundColor="Transparent"
                               IsSpellCheckEnabled="False"
                               IsTextPredictionEnabled="False"
                               ReturnType="Next" />
                    </Grid>
                </Border>

                <!-- 6. Campo: Contraseña -->
                <Label Text="Contraseña"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#374151"
                       Margin="0, 0, 0, 8" />

                <Border StrokeThickness="1"
                        Stroke="#E5E7EB"
                        BackgroundColor="#F9FAFB"
                        StrokeShape="RoundRectangle 14"
                        Padding="14, 2"
                        Margin="0, 0, 0, 12">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="lock.png"
                               HeightRequest="20"
                               WidthRequest="20"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="••••••••••••"
                               PlaceholderColor="#9CA3AF"
                               Text="{Binding Password}"
                               TextColor="#1F2937"
                               IsPassword="{Binding IsPasswordHidden}"
                               FontSize="14"
                               HeightRequest="48"
                               VerticalOptions="Center"
                               BackgroundColor="Transparent"
                               IsSpellCheckEnabled="False"
                               IsTextPredictionEnabled="False"
                               ReturnType="Done" />
                        <ImageButton Grid.Column="2"
                                     Source="eye.png"
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     BackgroundColor="Transparent"
                                     Padding="0"
                                     VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- 7. Enlace: ¿Olvidaste tu contraseña? -->
                <Label Text="¿Olvidaste tu contraseña?"
                       FontSize="13"
                       TextColor="#6B7280"
                       HorizontalOptions="End"
                       Margin="0, 0, 0, 26">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- 8. Botón: Iniciar sesión -->
                <Button Text="Iniciar sesión"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="52"
                        Margin="0, 0, 0, 10">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource PrimaryColor}"
                                Offset="0, 6"
                                Radius="14"
                                Opacity="0.35" />
                    </Button.Shadow>
                </Button>

                <!-- Indicador de Carga Reactivo -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryColor}"
                                   HeightRequest="26"
                                   Margin="0, 6, 0, 0" />

            </VerticalStackLayout>

            <!-- 9. Pie de Pantalla: Enlace a Registro -->
            <HorizontalStackLayout Grid.Row="1"
                                   HorizontalOptions="Center"
                                   Spacing="6"
                                   Margin="0, 10, 0, 24">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="¿Aún no tienes cuenta?" 
                       TextColor="#6B7280" 
                       FontSize="13" />
                <Label Text="Regístrate aquí"
                       TextColor="{StaticResource PrimaryColor}"
                       FontAttributes="Bold"
                       FontSize="13" />
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
