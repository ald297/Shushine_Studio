<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Auth"
             xmlns:components="clr-namespace:ShushineStudio.Mobile.Presentation.Components"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="false"
             Shell.TabBarIsVisible="false"
             Shell.FlyoutItemIsVisible="false">

    <ScrollView>
        <Grid RowDefinitions="*, Auto" MinimumHeightRequest="700" Padding="0, 10">
            <VerticalStackLayout Grid.Row="0"
                                 Padding="20, 20, 20, 16"
                                 Spacing="0"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center">

                <!-- 1. IDENTIDAD DE MARCA: Logotipo Oficial Flor de Loto -->
                <Image Source="shunshine_logo.svg"
                       HeightRequest="115"
                       WidthRequest="150"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0, 10, 0, 14" />

                <!-- 2. ENCABEZADO EDITORIAL (Stitch: Playfair Display / Hola de nuevo) -->
                <Label Text="Hola de nuevo"
                       Style="{StaticResource TitleLabelStyle}"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Ingresa a tu cuenta para continuar."
                       Style="{StaticResource SubheaderLabelStyle}"
                       FontSize="15"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       Margin="0, 6, 0, 22" />

                <!-- 3. TARJETA DEL FORMULARIO (Card Canvas) -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="24, 24"
                        Margin="4, 0">
                    <VerticalStackLayout Spacing="0">
                        <!-- Línea decorativa dorada de acento superior -->
                        <BoxView HeightRequest="3"
                                 CornerRadius="1.5"
                                 Color="{StaticResource Secondary}"
                                 Margin="0, 0, 0, 18" />

                        <!-- Banner de Error Contextual -->
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource StatusCanceladaBorder}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource StatusCanceladaBg}"
                                Padding="14, 12"
                                Margin="0, 0, 0, 16"
                                IsVisible="{Binding HasError}">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="⚠️" FontSize="15" VerticalOptions="Center" />
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="{StaticResource Error}"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Campo: Usuario o Correo -->
                        <components:CustomEntry LabelText="Usuario o Correo"
                                                Placeholder="admin o cliente"
                                                Text="{Binding Email}"
                                                Keyboard="Text"
                                                ReturnType="Next"
                                                LeadingIcon="mail.svg" />

                        <!-- Campo: Contraseña -->
                        <components:CustomEntry LabelText="Contraseña"
                                                Placeholder="••••••••"
                                                Text="{Binding Password}"
                                                IsPassword="{Binding IsPasswordHidden}"
                                                IsPasswordToggleEnabled="True"
                                                ReturnType="Done"
                                                LeadingIcon="lock.svg" />

                        <!-- Enlace: ¿Olvidaste tu contraseña? -->
                        <Label Text="¿Olvidaste tu contraseña?"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="End"
                               Margin="0, 0, 0, 20">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Botón Principal: Iniciar sesión -->
                        <Button Text="Iniciar sesión"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HeightRequest="54"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                Margin="0, 4, 0, 0" />

                        <!-- Indicador de Carga Reactivo -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="32"
                                           Margin="0, 12, 0, 0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- 4. PIE DE PANTALLA: Enlace a Registro -->
            <HorizontalStackLayout Grid.Row="1"
                                   HorizontalOptions="Center"
                                   Spacing="8"
                                   Margin="0, 16, 0, 24">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="¿Aún no tienes una cuenta?"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="14" />
                <Label Text="Crear cuenta →"
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       FontSize="14" />
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
