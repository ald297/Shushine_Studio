<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Auth"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="false">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24" VerticalOptions="Center">
            
            <!-- Cabecera de Marca -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,20,0,10">
                <Label Text="Shushine Studio"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}"
                       HorizontalOptions="Center" />
                <Label Text="Tu espacio exclusivo de belleza y bienestar"
                       FontSize="14"
                       TextColor="{StaticResource TextColorSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Tarjeta de Formulario de Inicio de Sesión -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                <VerticalStackLayout Spacing="16">
                    
                    <Label Text="Bienvenida de nuevo"
                           Style="{StaticResource HeaderLabelStyle}"
                           FontSize="22" />
                    <Label Text="Ingresa tus credenciales para gestionar tus citas."
                           Style="{StaticResource SubheaderLabelStyle}"
                           FontSize="13" />

                    <!-- Campo Correo Electrónico -->
                    <VerticalStackLayout Spacing="6" Margin="0,6,0,0">
                        <Label Text="Correo Electrónico" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="ejemplo@correo.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="••••••••"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       ReturnType="Done" />
                                <ImageButton Grid.Column="1"
                                             Source="eye.png"
                                             Command="{Binding TogglePasswordVisibilityCommand}"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Enlace: ¿Olvidaste tu contraseña? (Wireframe Pág. 6) -->
                    <Label Text="¿Olvidaste tu contraseña?"
                           TextColor="{StaticResource PrimaryDark}"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="End"
                           Margin="0,2,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Botón Iniciar Sesión -->
                    <Button Text="Iniciar Sesión"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={x:Null}}"
                            Margin="0,10,0,0" />

                    <!-- Indicador de Carga Reactivo -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HeightRequest="30" />
                </VerticalStackLayout>
            </Border>

            <!-- Pie de Pantalla: Enlace a Registro -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,20">
                <Label Text="¿Aún no tienes cuenta?" 
                       TextColor="{StaticResource TextColorSecondary}" 
                       FontSize="14" />
                <Label Text="Regístrate aquí"
                       TextColor="{StaticResource PrimaryColor}"
                       FontAttributes="Bold"
                       FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
