<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShushineStudio.Mobile.Presentation.Views.Chat.CustomRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Chat"
    xmlns:models="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:DataType="vm:CustomRequestViewModel"
    Shell.NavBarIsVisible="false"
    BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══════════════════════════════════════════ -->
        <!-- HEADER                                     -->
        <!-- ══════════════════════════════════════════ -->
        <Grid
            Grid.Row="0"
            BackgroundColor="{StaticResource Surface}"
            Padding="16,52,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="44,*,44">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.svg"
                    Command="{Binding GoBackCommand}"
                    WidthRequest="28"
                    HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Solicitud Personalizada"
                        FontFamily="PlayfairDisplay"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView
                        HeightRequest="2"
                        WidthRequest="40"
                        BackgroundColor="{StaticResource Secondary}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <BoxView
                Grid.Row="1"
                HeightRequest="1"
                BackgroundColor="{StaticResource Border}"
                Margin="0,12,0,0" />
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!-- CUERPO                                     -->
        <!-- ══════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="20,20,20,20">

                <!-- Mensaje de éxito -->
                <Frame
                    IsVisible="{Binding HasSuccessMessage}"
                    BackgroundColor="#E8F5E9"
                    BorderColor="#81C784"
                    CornerRadius="10"
                    Padding="14,10"
                    HasShadow="False"
                    Margin="0,0,0,16">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="16" FontAttributes="Bold" TextColor="#2E7D32" VerticalOptions="Center" />
                        <Label
                            Text="{Binding SuccessMessage}"
                            FontFamily="PlusJakartaSans"
                            FontSize="13"
                            TextColor="#1B5E20"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Frame>

                <!-- Introducción -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,20">
                    <Label
                        Text="Cuéntanos qué diseño tienes en mente"
                        FontFamily="PlayfairDisplay"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />
                    <Label
                        Text="Descríbenos tu idea y nuestro equipo te enviará una cotización personalizada."
                        FontFamily="PlusJakartaSans"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        LineBreakMode="WordWrap" />
                    <BoxView
                        HeightRequest="2"
                        WidthRequest="48"
                        BackgroundColor="{StaticResource Secondary}"
                        HorizontalOptions="Start"
                        Margin="0,4,0,0" />
                </VerticalStackLayout>

                <!-- Campo: Tipo de servicio (opcional) -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,16">
                    <Label
                        Text="Servicio o especialidad (opcional)"
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />
                    <Frame
                        BackgroundColor="{StaticResource InputBackground}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="12"
                        Padding="16,0"
                        HasShadow="False"
                        HeightRequest="48">
                        <Entry
                            Text="{Binding ServicioDeseado}"
                            Placeholder="Ej: Uñas acrílicas, Tintes, Peinado de fiesta..."
                            PlaceholderColor="{StaticResource TextSecondary}"
                            FontFamily="PlusJakartaSans"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Campo: Descripción -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,20">
                    <Label
                        Text="Describe tu idea"
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />
                    <Frame
                        BackgroundColor="{StaticResource InputBackground}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="12"
                        Padding="16,10"
                        HasShadow="False">
                        <Editor
                            Text="{Binding Description}"
                            Placeholder="Ej: Diseño floral en uñas con tonos rosas y dorados, largo mediano..."
                            PlaceholderColor="{StaticResource TextSecondary}"
                            FontFamily="PlusJakartaSans"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"
                            HeightRequest="120"
                            AutoSize="TextChanges" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Imagen de referencia -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,20">
                    <Label
                        Text="Imagen de referencia (opcional)"
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <!-- Estado: sin imagen adjunta -->
                    <Border
                        IsVisible="{Binding HasAttachedImage, Converter={StaticResource InvertedBoolConverter}}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource InputBackground}"
                        Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AttachImageCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="📎" FontSize="26" HorizontalOptions="Center" />
                            <Label
                                Text="Toca para adjuntar una foto de referencia"
                                FontFamily="PlusJakartaSans"
                                FontSize="13"
                                TextColor="{StaticResource Secondary}"
                                FontAttributes="Bold"
                                HorizontalOptions="Center" />
                            <ActivityIndicator
                                IsRunning="{Binding IsUploadingImage}"
                                IsVisible="{Binding IsUploadingImage}"
                                Color="{StaticResource Primary}"
                                WidthRequest="20"
                                HeightRequest="20" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Estado: imagen adjunta -->
                    <Border
                        IsVisible="{Binding HasAttachedImage}"
                        Stroke="{StaticResource Secondary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="12">
                        <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="12">
                            <Image
                                Grid.Column="0"
                                Source="{Binding AttachedImageUrl}"
                                Aspect="AspectFill"
                                WidthRequest="60"
                                HeightRequest="60">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,60,60" />
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Foto adjunta" FontFamily="PlusJakartaSans" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Lista para enviar con tu solicitud" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="2"
                                Text="✕"
                                Command="{Binding QuitarImagenCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#C62828"
                                FontSize="16"
                                FontAttributes="Bold"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Error banner -->
                <Frame
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#FFEBEE"
                    BorderColor="#FFCDD2"
                    CornerRadius="8"
                    Padding="12,8"
                    HasShadow="False"
                    Margin="0,0,0,12">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontFamily="PlusJakartaSans"
                        FontSize="12"
                        TextColor="#C62828" />
                </Frame>

                <!-- Historial de solicitudes -->
                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    <HorizontalStackLayout Spacing="8">
                        <Label
                            Text="Mis solicitudes"
                            FontFamily="PlayfairDisplay"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Button
                            Text="↻"
                            Command="{Binding CargarSolicitudesCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="16"
                            Padding="4,0"
                            HeightRequest="32"
                            WidthRequest="32" />
                    </HorizontalStackLayout>

                    <!-- Estado vacío -->
                    <Frame
                        IsVisible="{Binding ShowEmptyState}"
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="12"
                        Padding="20"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="✨" FontSize="28" HorizontalOptions="Center" />
                            <Label
                                Text="Sin solicitudes todavía"
                                FontFamily="PlusJakartaSans"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Tus solicitudes personalizadas y cotizaciones aparecerán aquí."
                                FontFamily="PlusJakartaSans"
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Lista de solicitudes reales -->
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Requests}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SolicitudDiseno">
                                <Border
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16,14">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label
                                                    Text="{Binding NotasCliente}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource TextPrimary}" />
                                                <Label
                                                    Text="{Binding FechaTexto}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="11"
                                                    TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <!-- Badge de Estado -->
                                            <Frame
                                                Grid.Column="1"
                                                BackgroundColor="#FCECEF"
                                                BorderColor="#F7CAD3"
                                                CornerRadius="8"
                                                Padding="10,4"
                                                HasShadow="False"
                                                VerticalOptions="Start">
                                                <Label
                                                    Text="{Binding Estado}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource Primary}" />
                                            </Frame>
                                        </Grid>

                                        <!-- Foto de referencia enviada -->
                                        <Image
                                            IsVisible="{Binding TieneFoto}"
                                            Source="{Binding ImagenesReferenciaUrls}"
                                            Aspect="AspectFit"
                                            HeightRequest="120"
                                            HorizontalOptions="Start" />

                                        <!-- Sección de Cotización si el salón ya respondió -->
                                        <Border
                                            IsVisible="{Binding TieneCotizacion}"
                                            Stroke="{StaticResource Secondary}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#FFFDF8"
                                            Padding="14"
                                            Margin="0,4,0,0">
                                            <VerticalStackLayout Spacing="6">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="Cotización:" FontFamily="PlusJakartaSans" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                                    <Label Text="{Binding Cotizacion.PrecioTexto}" FontFamily="PlusJakartaSans" FontSize="14" FontAttributes="Bold" TextColor="#2E7D32" />
                                                </HorizontalStackLayout>
                                                <Label
                                                    Text="{Binding Cotizacion.DescripcionTrabajo}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="12"
                                                    TextColor="{StaticResource TextPrimary}" />

                                                <!-- Botones Aceptar / Rechazar si está propuesta -->
                                                <HorizontalStackLayout
                                                    IsVisible="{Binding EsCotizacionPropuesta}"
                                                    Spacing="12"
                                                    Margin="0,6,0,0">
                                                    <Button
                                                        Text="Aceptar"
                                                        BackgroundColor="#2E7D32"
                                                        TextColor="White"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        HeightRequest="36"
                                                        CornerRadius="8"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomRequestViewModel}}, Path=AceptarCotizacionCommand}"
                                                        CommandParameter="{Binding .}" />
                                                    <Button
                                                        Text="Rechazar"
                                                        BackgroundColor="#C62828"
                                                        TextColor="White"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        HeightRequest="36"
                                                        CornerRadius="8"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomRequestViewModel}}, Path=RechazarCotizacionCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════ -->
        <!-- BOTÓN ENVIAR                               -->
        <!-- ══════════════════════════════════════════ -->
        <Grid
            Grid.Row="2"
            BackgroundColor="{StaticResource Surface}"
            Padding="20,12,20,30">

            <Button
                Text="Enviar solicitud"
                Command="{Binding SubmitRequestCommand}"
                IsVisible="{Binding IsNotSubmitting}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource TextLight}"
                FontFamily="PlusJakartaSans"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="12"
                HeightRequest="52" />

            <Frame
                IsVisible="{Binding IsSubmitting}"
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="12"
                Padding="0"
                HasShadow="False"
                HeightRequest="52">
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator
                        IsRunning="{Binding IsSubmitting}"
                        Color="{StaticResource TextLight}"
                        WidthRequest="22"
                        HeightRequest="22" />
                    <Label
                        Text="Enviando..."
                        FontFamily="PlusJakartaSans"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
