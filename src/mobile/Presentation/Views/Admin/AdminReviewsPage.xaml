<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    xmlns:models="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminReviewsPage"
    x:DataType="vm:AdminReviewsViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}">

    <Grid>
        <!-- ACCESO RESTRINGIDO (NO ADMIN) -->
        <VerticalStackLayout
            IsVisible="{Binding IsUnauthorized}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="32"
            Spacing="16">

            <Frame BackgroundColor="{StaticResource SurfaceVariant}" CornerRadius="36" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" HasShadow="False">
                <Label Text="🔒" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <Label Text="Acceso Restringido" FontFamily="PlayfairDisplay" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
            <Label Text="Esta pantalla requiere privilegios de Administrador de Shushine Studio." FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            <Button Text="Regresar al Login" Command="{Binding RegresarALoginCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />
        </VerticalStackLayout>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid IsVisible="{Binding IsAuthorized}" RowDefinitions="Auto,*">

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
                <Grid ColumnDefinitions="40,*,40">
                    <ImageButton
                        Grid.Column="0"
                        Source="arrow_left.png"
                        Command="{Binding RegresarCommand}"
                        WidthRequest="28" HeightRequest="28"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start" VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Reseñas" FontFamily="PlayfairDisplay" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="4" Padding="5,1" HasShadow="False" VerticalOptions="Center">
                                <Label Text="ADMIN" FontFamily="PlusJakartaSans" FontSize="8" FontAttributes="Bold" TextColor="{StaticResource Surface}" />
                            </Frame>
                        </HorizontalStackLayout>
                        <Label Text="Satisfacción y Feedback de Clientes" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <ImageButton
                        Grid.Column="2"
                        Source="sync.png"
                        Command="{Binding CargarResenasCommand}"
                        WidthRequest="24" HeightRequest="24"
                        BackgroundColor="Transparent"
                        HorizontalOptions="End" VerticalOptions="Center" />
                </Grid>
            </Grid>

            <!-- 2. LISTA DE RESEÑAS -->
            <Grid Grid.Row="1" Padding="20">
                <!-- INDICADOR DE CARGA -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />

                <!-- ESTADO VACÍO -->
                <VerticalStackLayout IsVisible="{Binding NoTieneResenas}" VerticalOptions="Center" HorizontalOptions="Center" Padding="32" Spacing="8">
                    <Label Text="🌟" FontSize="44" HorizontalOptions="Center" />
                    <Label Text="No hay reseñas registradas" FontFamily="PlayfairDisplay" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Las evaluaciones otorgadas por las clientas tras completar sus citas se listarán aquí en tiempo real." FontFamily="PlusJakartaSans" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- LISTADO REAL -->
                <CollectionView ItemsSource="{Binding Resenas}" IsVisible="{Binding TieneResenas}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Resena">
                            <Border
                                Stroke="{StaticResource Outline}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource Surface}"
                                StrokeShape="RoundRectangle 14"
                                Padding="16"
                                Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding ClienteNombre}" FontFamily="PlusJakartaSans" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Grid.Column="1" Text="{Binding EstrellasTexto}" TextColor="#FFB300" FontSize="14" FontAttributes="Bold" />
                                    </Grid>

                                    <Label Text="{Binding ServicioNombre}" FontFamily="PlusJakartaSans" FontSize="12" TextColor="{StaticResource Primary}" />

                                    <Label Text="{Binding Comentario}" FontFamily="PlusJakartaSans" FontSize="13" TextColor="{StaticResource TextSecondary}" LineHeight="1.3" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Grid.Column="0" Text="{Binding EstilistaNombre, StringFormat='Atendida por: {0}'}" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextTertiary}" />
                                        <Label Grid.Column="1" Text="{Binding FechaFormateada}" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextTertiary}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
