<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminReviewsPage"
    x:DataType="vm:AdminReviewsViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}">

    <Grid>
        <!-- ACCESO RESTRINGIDO (NO ADMIN) -->
        <VerticalStackLayout
            IsVisible="{Binding IsUnauthorized}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="32"
            Spacing="16">

            <Frame BackgroundColor="{StaticResource SurfaceVariant}" CornerRadius="36" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" HasShadow="False">
                <Label Text="🔒" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <Label Text="Acceso Restringido" FontFamily="PlayfairDisplay" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
            <Label Text="Esta pantalla requiere privilegios de Administrador de Shushine Studio." FontFamily="PlusJakartaSans" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            <Button Text="Regresar al Login" Command="{Binding RegresarALoginCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />
        </VerticalStackLayout>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid IsVisible="{Binding IsAuthorized}" RowDefinitions="Auto,*">

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
                <Grid ColumnDefinitions="40,*,40">
                    <ImageButton
                        Grid.Column="0"
                        Source="arrow_left.png"
                        Command="{Binding RegresarCommand}"
                        WidthRequest="28" HeightRequest="28"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start" VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Reseñas" FontFamily="PlayfairDisplay" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="4" Padding="5,1" HasShadow="False" VerticalOptions="Center">
                                <Label Text="ADMIN" FontFamily="PlusJakartaSans" FontSize="8" FontAttributes="Bold" TextColor="{StaticResource Surface}" />
                            </Frame>
                        </HorizontalStackLayout>
                        <Label Text="Satisfacción y Feedback de Clientes" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- 2. CUERPO -->
            <ScrollView Grid.Row="1" Padding="20,20,20,32">
                <VerticalStackLayout Spacing="20">

                    <!-- BANNER AVISO BACKEND -->
                    <Border
                        Stroke="#FFE0B2"
                        StrokeThickness="1"
                        BackgroundColor="#FFF8E1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="⭐" FontSize="24" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="UI Preparada — Backend No Disponible" FontFamily="PlusJakartaSans" FontSize="13" FontAttributes="Bold" TextColor="#E65100" />
                                <Label Text="{Binding AvisoBackend}" FontFamily="PlusJakartaSans" FontSize="12" TextColor="#795548" LineHeight="1.3" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- TARJETA INFORMATIVA -->
                    <Border
                        Stroke="{StaticResource Outline}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,4" Radius="12" Opacity="0.8" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="16">
                            <Label Text="Panel de Calidad y Experiencia" FontFamily="PlayfairDisplay" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label
                                Text="El módulo administrativo de reseñas permitirá al equipo gerencial monitorear el índice de satisfacción post-servicio (1 a 5 estrellas), filtrar testimonios por profesional o servicio y publicar respuestas oficiales del salón a las clientas."
                                FontFamily="PlusJakartaSans"
                                FontSize="13"
                                TextColor="{StaticResource TextSecondary}"
                                LineHeight="1.3" />

                            <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                            <Button
                                Text="Consultar Detalle de Moderación"
                                Command="{Binding VerDetalleResenaCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HeightRequest="44"
                                FontSize="13"
                                CornerRadius="8" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ESTADO VACÍO -->
                    <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center">
                        <Label Text="🌟" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="No hay reseñas registradas" FontFamily="PlayfairDisplay" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                        <Label Text="Las evaluaciones otorgadas por las clientas tras completar sus citas se listarán aquí." FontFamily="PlusJakartaSans" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
