<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminProfilePage"
             x:DataType="vm:AdminProfileViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="false"
             Title="{Binding Title}">

    <Grid>
        <!-- Toast de Notificación Boutique Flotante -->
        <Border VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="20, 52, 20, 0"
                Padding="16, 12"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#2C2420"
                Stroke="#C5A059"
                StrokeThickness="1"
                IsVisible="{Binding IsToastVisible}"
                ZIndex="999">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 18"
                        WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#3D322C"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Label Text="✨" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding ToastTitulo}" FontSize="13" FontAttributes="Bold" TextColor="#F5EBE6" />
                    <Label Text="{Binding ToastMensaje}" FontSize="11" TextColor="#D48B96" />
                </VerticalStackLayout>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarToastCommand}" />
            </Border.GestureRecognizers>
        </Border>

        <!-- Contenido Principal -->
        <ScrollView>
            <VerticalStackLayout Padding="20, 52, 20, 36" Spacing="18">

                <!-- 1. Cabecera Hero de Gerencia / Administrador -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0, 8, 0, 4">
                    <!-- Avatar Circular con Borde Dorado -->
                    <Border StrokeShape="RoundRectangle 50"
                            HeightRequest="100"
                            WidthRequest="100"
                            Stroke="#C5A059"
                            StrokeThickness="3"
                            BackgroundColor="#FAF8F5"
                            HorizontalOptions="Center">
                        <Grid>
                            <Label Text="👑"
                                   FontSize="46"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border StrokeShape="RoundRectangle 12"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    BackgroundColor="#C5A059"
                                    Stroke="White"
                                    StrokeThickness="2"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Margin="0, 0, 4, 4">
                                <Label Text="✓"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Nombre y Correo del Gerente -->
                    <Label Text="{Binding NombreGerente}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextColorPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding EmailGerente}"
                           FontSize="13"
                           TextColor="{StaticResource TextColorSecondary}"
                           HorizontalOptions="Center" />

                    <!-- Badge Rol Administrador -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FAF4E8"
                            Stroke="#EADCC6"
                            StrokeThickness="1"
                            Padding="14, 5"
                            HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="💼" FontSize="12" VerticalOptions="Center" />
                            <Label Text="{Binding Rol}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A68038"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. Tarjeta Ejecutiva del Salón (Estilo Espresso & Oro) -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="#C5A059"
                        StrokeThickness="1.5"
                        Padding="20"
                        Margin="0, 4, 0, 0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2C2420" Offset="0.0" />
                            <GradientStop Color="#1E1916" Offset="0.7" />
                            <GradientStop Color="#120F0D" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="SHUNSHINE STUDIO"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#C5A059"
                                       CharacterSpacing="1.5" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#3D322C"
                                    Padding="8, 3">
                                <Label Text="SALÓN &amp; SPA"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="#D48B96" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Panel de Control &amp; Gestión"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Label Text="Supervisión en tiempo real de citas, catálogo y equipo profesional."
                                   FontSize="12"
                                   TextColor="#D1C7BD" />
                        </VerticalStackLayout>

                        <!-- Indicadores Rápidos -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0, 6, 0, 0">
                            <!-- Métricas Servicios -->
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#3A302A"
                                    Padding="8, 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalServicios}" FontSize="18" FontAttributes="Bold" TextColor="#C5A059" HorizontalOptions="Center" />
                                    <Label Text="Servicios" FontSize="10" TextColor="#D1C7BD" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IrACatalogoCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Métricas Estilistas -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#3A302A"
                                    Padding="8, 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalEstilistas}" FontSize="18" FontAttributes="Bold" TextColor="#D48B96" HorizontalOptions="Center" />
                                    <Label Text="Estilistas" FontSize="10" TextColor="#D1C7BD" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IrAEstilistasCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Métricas Citas Hoy -->
                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#3A302A"
                                    Padding="8, 10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalCitasHoy}" FontSize="18" FontAttributes="Bold" TextColor="#A7F3D0" HorizontalOptions="Center" />
                                    <Label Text="Citas Hoy" FontSize="10" TextColor="#D1C7BD" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IrAAgendaCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Parámetros Operativos del Negocio -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="PARÁMETROS OPERATIVOS DEL SALÓN"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorSecondary}"
                               CharacterSpacing="1" />

                        <!-- Sucursal -->
                        <Grid ColumnDefinitions="32, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SecondaryLight}" HeightRequest="32" WidthRequest="32">
                                <Label Text="📍" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Sede Principal" FontSize="11" TextColor="{StaticResource TextColorSecondary}" />
                                <Label Text="{Binding Sucursal}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource SecondaryLight}" />

                        <!-- Horario de Operación -->
                        <Grid ColumnDefinitions="32, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SecondaryLight}" HeightRequest="32" WidthRequest="32">
                                <Label Text="⏱" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Horario de Atención" FontSize="11" TextColor="{StaticResource TextColorSecondary}" />
                                <Label Text="{Binding HorarioOperativo}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource SecondaryLight}" />

                        <!-- Política Fiscal -->
                        <Grid ColumnDefinitions="32, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SecondaryLight}" HeightRequest="32" WidthRequest="32">
                                <Label Text="🧾" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Régimen Fiscal &amp; Facturación" FontSize="11" TextColor="{StaticResource TextColorSecondary}" />
                                <Label Text="{Binding PoliticaFiscal}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColorPrimary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Infraestructura & Conectividad del Sistema -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="INFRAESTRUCTURA &amp; SEGURIDAD"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorSecondary}"
                               CharacterSpacing="1" />

                        <Grid ColumnDefinitions="32, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#ECFDF5" HeightRequest="32" WidthRequest="32">
                                <Label Text="🟢" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Estado de la Web API" FontSize="11" TextColor="{StaticResource TextColorSecondary}" />
                                <Label Text="{Binding BackendInfo}" FontSize="13" FontAttributes="Bold" TextColor="#059669" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Base de datos PostgreSQL en la nube protegida con Spring Security 6 y JJWT."
                               FontSize="11"
                               TextColor="{StaticResource TextColorSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Botón Cerrar Sesión Administrativa de Lujo -->
                <Border StrokeShape="RoundRectangle 24"
                        BackgroundColor="#FFF5F5"
                        Stroke="#FED7D7"
                        StrokeThickness="1"
                        HeightRequest="48"
                        Margin="0, 8, 0, 24"
                        HorizontalOptions="Fill">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🚪" FontSize="16" VerticalOptions="Center" />
                        <Label Text="Cerrar Sesión de Administrador"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#E53E3E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
