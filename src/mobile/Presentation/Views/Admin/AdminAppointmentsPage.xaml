<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminAppointmentsPage"
    x:DataType="vm:AdminAppointmentsViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Gestión de Citas">

    <Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- PANTALLA NO AUTORIZADO                                  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <VerticalStackLayout
            IsVisible="{Binding IsUnauthorized}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="32"
            Spacing="20">
            <Frame
                WidthRequest="80" HeightRequest="80"
                CornerRadius="40"
                BackgroundColor="#FDE8E8"
                BorderColor="#F8B4B4"
                Padding="0"
                HorizontalOptions="Center"
                HasShadow="False">
                <Label Text="🔒" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <Label
                Text="Acceso Restringido"
                FontFamily="PlayfairDisplay"
                FontSize="22" FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Esta pantalla requiere privilegios de Administrador de Shushine Studio."
                FontFamily="PlusJakartaSans"
                FontSize="14"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center" />

            <Button
                Text="Regresar al Login"
                Command="{Binding RegresarALoginCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HeightRequest="48"
                FontSize="14"
                CornerRadius="12" />
        </VerticalStackLayout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTENIDO PRINCIPAL                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsAuthorized}" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
                <Grid ColumnDefinitions="40,*,Auto">
                    <ImageButton
                        Grid.Column="0"
                        Source="arrow_left.svg"
                        Command="{Binding RegresarCommand}"
                        WidthRequest="28" HeightRequest="28"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start" VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label
                                Text="Gestión de Citas"
                                FontFamily="PlayfairDisplay"
                                FontSize="18" FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                            <Frame
                                BackgroundColor="{StaticResource Primary}"
                                CornerRadius="4"
                                Padding="5,1"
                                HasShadow="False"
                                VerticalOptions="Center">
                                <Label Text="ADMIN" FontFamily="PlusJakartaSans" FontSize="8" FontAttributes="Bold" TextColor="{StaticResource Surface}" />
                            </Frame>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="2" WidthRequest="40" BackgroundColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="+ Nueva"
                        Command="{Binding NuevaCitaWalkInCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource Surface}"
                        FontFamily="PlusJakartaSans"
                        FontSize="11" FontAttributes="Bold"
                        Padding="10,0"
                        HeightRequest="32"
                        CornerRadius="8" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,14,0,0" VerticalOptions="End" />
            </Grid>

            <!-- 2. BARRA DE BÚSQUEDA -->
            <Frame
                Grid.Row="1"
                BackgroundColor="{StaticResource Surface}"
                BorderColor="{StaticResource Border}"
                CornerRadius="14"
                Padding="12,4"
                Margin="16,10,16,6"
                HasShadow="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" Margin="4,0,8,0" />
                    <Entry
                        Grid.Column="1"
                        Placeholder="Buscar por clienta, código o servicio..."
                        Text="{Binding TextoBusqueda}"
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        TextColor="{StaticResource TextPrimary}"
                        PlaceholderColor="{StaticResource TextSecondary}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- 3. CHIPS DE FILTRO POR ESTADO REAL -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,4">
                <HorizontalStackLayout Spacing="8">
                    <Button
                        Text="Todas"
                        Command="{Binding FiltrarPorEstadoCommand}"
                        CommandParameter="Todas"
                        FontSize="12" HeightRequest="32" CornerRadius="16"
                        Padding="14,0"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource Surface}" />
                    <Button
                        Text="Confirmadas"
                        Command="{Binding FiltrarPorEstadoCommand}"
                        CommandParameter="Confirmadas"
                        FontSize="12" HeightRequest="32" CornerRadius="16"
                        Padding="14,0"
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        TextColor="{StaticResource TextPrimary}" />
                    <Button
                        Text="En proceso"
                        Command="{Binding FiltrarPorEstadoCommand}"
                        CommandParameter="En proceso"
                        FontSize="12" HeightRequest="32" CornerRadius="16"
                        Padding="14,0"
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        TextColor="{StaticResource TextPrimary}" />
                    <Button
                        Text="Completadas"
                        Command="{Binding FiltrarPorEstadoCommand}"
                        CommandParameter="Completadas"
                        FontSize="12" HeightRequest="32" CornerRadius="16"
                        Padding="14,0"
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        TextColor="{StaticResource TextPrimary}" />
                    <Button
                        Text="Canceladas"
                        Command="{Binding FiltrarPorEstadoCommand}"
                        CommandParameter="Canceladas"
                        FontSize="12" HeightRequest="32" CornerRadius="16"
                        Padding="14,0"
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        TextColor="{StaticResource TextPrimary}" />
                    <Button
                        Text="Pendientes"
                        Command="{Binding FiltrarPorEstadoCommand}"
                        CommandParameter="Pendientes"
                        FontSize="12" HeightRequest="32" CornerRadius="16"
                        Padding="14,0"
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        TextColor="{StaticResource TextPrimary}" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- 4. CONTADOR DE CITAS -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="20,8,20,4">
                <Label
                    Grid.Column="0"
                    Text="Citas del Salón"
                    FontFamily="PlusJakartaSans"
                    FontSize="12" FontAttributes="Bold"
                    TextColor="{StaticResource Secondary}"
                    CharacterSpacing="1" />
                <Label
                    Grid.Column="1"
                    Text="{Binding TotalCitas, StringFormat='{0} encontradas'}"
                    FontFamily="PlusJakartaSans"
                    FontSize="12" FontAttributes="Bold"
                    TextColor="{StaticResource Primary}" />
            </Grid>

            <!-- 5. LISTADO DE CITAS -->
            <RefreshView Grid.Row="4" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCitasCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="16,6,16,24" Spacing="10">

                        <!-- MENSAJE DE ERROR -->
                        <Frame
                            IsVisible="{Binding ErrorMessage, Converter={x:Null}}"
                            BackgroundColor="#FEF2F2"
                            BorderColor="#FCA5A5"
                            CornerRadius="12"
                            Padding="14,10"
                            HasShadow="False">
                            <Label Text="{Binding ErrorMessage}"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="12"
                                   TextColor="#991B1B"
                                   HorizontalTextAlignment="Center" />
                        </Frame>

                        <!-- ESTADO VACÍO -->
                        <Frame
                            IsVisible="{Binding EstaVacio}"
                            BackgroundColor="{StaticResource Surface}"
                            BorderColor="{StaticResource Border}"
                            CornerRadius="16"
                            Padding="24,32"
                            Margin="0,16"
                            HasShadow="False">
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Label Text="📅" FontSize="36" HorizontalOptions="Center" />
                                <Label
                                    Text="Sin Citas para el Filtro Seleccionado"
                                    FontFamily="PlayfairDisplay"
                                    FontSize="16" FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    Text="No se encontraron citas que coincidan con los criterios de búsqueda o estado actual."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}"
                                    HorizontalTextAlignment="Center"
                                    LineHeight="1.3" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- COLECCIÓN DE CITAS -->
                        <CollectionView ItemsSource="{Binding CitasFiltradas}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="entities:Reserva">
                                    <Frame
                                        BackgroundColor="{StaticResource Surface}"
                                        BorderColor="{StaticResource Border}"
                                        CornerRadius="14"
                                        Padding="16,14"
                                        Margin="0,0,0,10"
                                        HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminAppointmentsViewModel}}, Path=IrADetalleCitaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout Spacing="8">
                                            
                                            <!-- ENCABEZADO: CLIENTE + ESTADO -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding ClienteNombre}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="15" FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                    <Label Text="{Binding CodigoCita, StringFormat='🏷 {0}'}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Secondary}" />
                                                </VerticalStackLayout>
                                                
                                                <Frame
                                                    Grid.Column="1"
                                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                                    BorderColor="{Binding EstadoColor}"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    HasShadow="False"
                                                    VerticalOptions="Start">
                                                    <Label Text="{Binding EstadoDisplay}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="10" FontAttributes="Bold"
                                                           TextColor="{Binding EstadoColor}" />
                                                </Frame>
                                            </Grid>

                                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                                            <!-- DETALLES: SERVICIO, ESTILISTA Y HORARIO -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                    <Label Text="{Binding ServicioNombre}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="13"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                    <Label Text="{Binding EstilistaNombre, StringFormat='👩‍🎨 {0}'}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextSecondary}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="3">
                                                    <Label Text="{Binding FechaHoraInicio, StringFormat='{0:dd MMM yyyy}'}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="12" FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding HorarioTexto}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="11"
                                                           TextColor="{StaticResource TextSecondary}"
                                                           HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <!-- FOOTER: TOTAL + ACCIÓN -->
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding TotalFormateado, StringFormat='Total: {0}'}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="13" FontAttributes="Bold"
                                                    TextColor="{StaticResource Primary}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="Gestionar ›"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="12" FontAttributes="Bold"
                                                    TextColor="{StaticResource Secondary}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
