<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminCreateServicePage"
    x:DataType="vm:AdminCreateServiceViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
            <Grid ColumnDefinitions="40,*,40">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.svg"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Nuevo Servicio"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Alta en Catálogo Oficial"
                        FontFamily="PlusJakartaSans"
                        FontSize="11"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- 2. FORMULARIO REAL DE CREACIÓN -->
        <ScrollView Grid.Row="1" Padding="20,16,20,32">
            <VerticalStackLayout Spacing="20">

                <Border
                    Stroke="{StaticResource Outline}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource Surface}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#10000000" Offset="0,4" Radius="12" Opacity="0.8" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Nombre del Servicio -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre del Servicio *" FontFamily="PlusJakartaSans" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeShape="RoundRectangle 8" Padding="12,0">
                                <Entry
                                    Text="{Binding Nombre}"
                                    Placeholder="Ej: Balayage Rubio Miel"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="13"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextSecondary}"
                                    HeightRequest="44" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Código de Servicio -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Código de Referencia" FontFamily="PlusJakartaSans" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeShape="RoundRectangle 8" Padding="12,0">
                                <Entry
                                    Text="{Binding CodigoServicio}"
                                    Placeholder="Ej: SRV-101"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="13"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextSecondary}"
                                    HeightRequest="44" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Categoría -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Categoría *" FontFamily="PlusJakartaSans" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeShape="RoundRectangle 8" Padding="12,0">
                                <Picker
                                    ItemsSource="{Binding CategoriasDisponibles}"
                                    SelectedItem="{Binding CategoriaSeleccionada}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="13"
                                    TextColor="{StaticResource TextPrimary}"
                                    HeightRequest="44" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Tarifa y Duración en 2 columnas -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <!-- Tarifa Base ($) -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Tarifa Base ($) *" FontFamily="PlusJakartaSans" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeShape="RoundRectangle 8" Padding="12,0">
                                    <Entry
                                        Text="{Binding Precio}"
                                        Keyboard="Numeric"
                                        Placeholder="35.00"
                                        FontFamily="PlusJakartaSans"
                                        FontSize="13"
                                        TextColor="{StaticResource TextPrimary}"
                                        PlaceholderColor="{StaticResource TextSecondary}"
                                        HeightRequest="44" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Duración (Minutos) -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Duración (min) *" FontFamily="PlusJakartaSans" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeShape="RoundRectangle 8" Padding="12,0">
                                    <Entry
                                        Text="{Binding DuracionMinutos}"
                                        Keyboard="Numeric"
                                        Placeholder="45"
                                        FontFamily="PlusJakartaSans"
                                        FontSize="13"
                                        TextColor="{StaticResource TextPrimary}"
                                        PlaceholderColor="{StaticResource TextSecondary}"
                                        HeightRequest="44" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Descripción -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Descripción del Servicio" FontFamily="PlusJakartaSans" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeShape="RoundRectangle 8" Padding="12,8">
                                <Editor
                                    Text="{Binding Descripcion}"
                                    Placeholder="Detalle del procedimiento, productos aplicados..."
                                    FontFamily="PlusJakartaSans"
                                    FontSize="13"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextSecondary}"
                                    HeightRequest="80"
                                    AutoSize="Disabled" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Switch Activo -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Servicio Activo" FontFamily="PlusJakartaSans" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Disponible inmediatamente en el catálogo de clientes y reservas" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding Activo}"
                                OnColor="{StaticResource Primary}"
                                ThumbColor="{StaticResource Surface}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- BOTONES DE ACCIÓN -->
                <VerticalStackLayout Spacing="12">
                    <Button
                        Text="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, StringFormat='Registrar Servicio'}"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="48"
                        FontSize="14" FontAttributes="Bold"
                        CornerRadius="12" />

                    <Button
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="48"
                        FontSize="14"
                        CornerRadius="12" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
