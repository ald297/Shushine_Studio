<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminClientsPage"
    x:DataType="vm:AdminClientsViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}">

    <Grid>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- PANTALLA DE ACCESO RESTRINGIDO (NO ADMIN)               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <VerticalStackLayout
            IsVisible="{Binding IsUnauthorized}"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="32"
            Spacing="16">

            <Frame
                BackgroundColor="{StaticResource SurfaceVariant}"
                CornerRadius="36"
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center"
                HasShadow="False">
                <Label Text="🔒" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <Label
                Text="Acceso Restringido"
                FontFamily="PlayfairDisplay"
                FontSize="22" FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Esta pantalla requiere privilegios de Administrador de Shushine Studio."
                FontFamily="PlusJakartaSans"
                FontSize="14"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center" />

            <Button
                Text="Regresar al Login"
                Command="{Binding RegresarALoginCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HeightRequest="48"
                FontSize="14"
                CornerRadius="12" />
        </VerticalStackLayout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTENIDO PRINCIPAL ADMINISTRATIVO                      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsAuthorized}" RowDefinitions="Auto,Auto,Auto,*">

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
                <Grid ColumnDefinitions="40,*,Auto">
                    <ImageButton
                        Grid.Column="0"
                        Source="arrow_left.svg"
                        Command="{Binding RegresarCommand}"
                        WidthRequest="28" HeightRequest="28"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start" VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label
                                Text="Clientes"
                                FontFamily="PlayfairDisplay"
                                FontSize="18" FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                            <Frame
                                BackgroundColor="{StaticResource Primary}"
                                CornerRadius="4"
                                Padding="5,1"
                                HasShadow="False"
                                VerticalOptions="Center">
                                <Label Text="ADMIN" FontFamily="PlusJakartaSans" FontSize="8" FontAttributes="Bold" TextColor="{StaticResource Surface}" />
                            </Frame>
                        </HorizontalStackLayout>
                        <Label
                            Text="Directorio de clientes"
                            FontFamily="PlusJakartaSans"
                            FontSize="11"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="+ Nuevo"
                        Command="{Binding NuevoClienteCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource Surface}"
                        FontFamily="PlusJakartaSans"
                        FontSize="12" FontAttributes="Bold"
                        CornerRadius="8"
                        Padding="10,0"
                        HeightRequest="34"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,14,0,0" VerticalOptions="End" />
            </Grid>

            <!-- 2. BARRA DE BÚSQUEDA LOCAL -->
            <VerticalStackLayout Grid.Row="1" Padding="20,12,20,4" Spacing="4">
                <Frame
                    BackgroundColor="{StaticResource Surface}"
                    BorderColor="{StaticResource Border}"
                    CornerRadius="12"
                    Padding="12,4"
                    HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                        <Entry
                            Grid.Column="1"
                            Text="{Binding TextoBusqueda}"
                            Placeholder="Buscar cliente por nombre o teléfono..."
                            FontFamily="PlusJakartaSans"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextSecondary}"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Frame>

                <Label
                    Text="Búsqueda local sobre clientes cargados desde el servidor"
                    FontFamily="PlusJakartaSans"
                    FontSize="10"
                    TextColor="{StaticResource TextSecondary}"
                    Margin="4,0,0,0" />
            </VerticalStackLayout>

            <!-- 3. CONTADOR DE CLIENTES -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="20,8,20,8">
                <Label
                    Grid.Column="0"
                    Text="{Binding TotalClientes, StringFormat='{0} clientes encontrados'}"
                    FontFamily="PlusJakartaSans"
                    FontSize="12" FontAttributes="Bold"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalOptions="Center" />
            </Grid>

            <!-- 4. LISTA DE CLIENTES -->
            <RefreshView Grid.Row="3" IsRefreshing="{Binding IsBusy}" Command="{Binding CargarClientesCommand}">
                <Grid>
                    <ScrollView Padding="20,4,20,24">
                        <VerticalStackLayout Spacing="10">

                            <!-- BANNER DE ERROR -->
                            <Frame
                                IsVisible="{Binding HasError}"
                                BackgroundColor="#FEF2F2"
                                BorderColor="#FCA5A5"
                                CornerRadius="12"
                                Padding="14,10"
                                HasShadow="False">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding ErrorMessage}"
                                           FontFamily="PlusJakartaSans"
                                           FontSize="12"
                                           TextColor="#991B1B"
                                           HorizontalTextAlignment="Center" />
                                    <Button Text="Reintentar"
                                            Command="{Binding CargarClientesCommand}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="{StaticResource Surface}"
                                            FontFamily="PlusJakartaSans"
                                            FontSize="11"
                                            HeightRequest="32"
                                            CornerRadius="6"
                                            HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Frame>

                            <!-- LISTADO DE CLIENTES -->
                            <CollectionView
                                ItemsSource="{Binding Clientes}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Cliente">
                                        <Frame
                                            BackgroundColor="{StaticResource Surface}"
                                            BorderColor="{StaticResource Border}"
                                            CornerRadius="14"
                                            Padding="14,12"
                                            Margin="0,0,0,8"
                                            HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminClientsViewModel}}, Path=SeleccionarClienteCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                
                                                <!-- AVATAR INICIALES -->
                                                <Frame
                                                    Grid.Column="0"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    CornerRadius="20"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"
                                                    HasShadow="False"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        Text="{Binding Iniciales}"
                                                        FontFamily="PlusJakartaSans"
                                                        FontSize="14" FontAttributes="Bold"
                                                        TextColor="{StaticResource Surface}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                </Frame>

                                                <!-- INFORMACIÓN DEL CLIENTE -->
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label
                                                        Text="{Binding NombreCompleto}"
                                                        FontFamily="PlusJakartaSans"
                                                        FontSize="14" FontAttributes="Bold"
                                                        TextColor="{StaticResource TextPrimary}" />

                                                    <HorizontalStackLayout Spacing="8">
                                                        <Label
                                                            Text="{Binding Telefono, TargetNullValue='Sin teléfono'}"
                                                            FontFamily="PlusJakartaSans"
                                                            FontSize="12"
                                                            TextColor="{StaticResource TextSecondary}" />
                                                    </HorizontalStackLayout>

                                                    <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                                        <Frame
                                                            BackgroundColor="{StaticResource SurfaceVariant}"
                                                            BorderColor="{Binding TipoClienteColor}"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            HasShadow="False">
                                                            <Label
                                                                Text="{Binding TipoClienteDisplay}"
                                                                FontFamily="PlusJakartaSans"
                                                                FontSize="9" FontAttributes="Bold"
                                                                TextColor="{Binding TipoClienteColor}" />
                                                        </Frame>

                                                        <Label
                                                            Text="{Binding TotalCitas, StringFormat='• {0} citas'}"
                                                            FontFamily="PlusJakartaSans"
                                                            FontSize="10"
                                                            TextColor="{StaticResource Secondary}"
                                                            VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>

                                                <!-- CHEVRON -->
                                                <Label
                                                    Grid.Column="2"
                                                    Text="›"
                                                    FontFamily="PlayfairDisplay"
                                                    FontSize="22" FontAttributes="Bold"
                                                    TextColor="{StaticResource TextSecondary}"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- ESTADO VACÍO -->
                            <Frame
                                IsVisible="{Binding EstaVacio}"
                                BackgroundColor="{StaticResource Surface}"
                                BorderColor="{StaticResource Border}"
                                CornerRadius="16"
                                Padding="28,36"
                                Margin="0,16,0,0"
                                HasShadow="False">
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Label Text="👥" FontSize="36" HorizontalOptions="Center" />
                                    <Label
                                        Text="No hay clientes para mostrar."
                                        FontFamily="PlayfairDisplay"
                                        FontSize="16" FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="No se encontraron registros de clientes en el sistema."
                                        FontFamily="PlusJakartaSans"
                                        FontSize="12"
                                        TextColor="{StaticResource TextSecondary}"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- INDICADOR DE CARGA -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource Primary}"
                        WidthRequest="40" HeightRequest="40"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </RefreshView>

        </Grid>
    </Grid>

</ContentPage>
