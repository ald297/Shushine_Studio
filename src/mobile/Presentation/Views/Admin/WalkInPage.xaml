<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
             xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.WalkInPage"
             x:DataType="vm:WalkInViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <!-- Cabecera -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Registro Rápido Walk-In"
                       Style="{StaticResource HeaderLabelStyle}"
                       FontSize="22" />
                <Label Text="Agenda una cita inmediata para un cliente presencial sin cuenta en la app."
                       Style="{StaticResource SubheaderLabelStyle}"
                       FontSize="13" />
            </VerticalStackLayout>

            <!-- Tarjeta Formulario Walk-in -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Nombre del Cliente Presencial -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre del Cliente Presencial *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="ej. Andrea Quintanilla"
                                   Text="{Binding NombreCliente}"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Teléfono / WhatsApp -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Teléfono de Contacto" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="7000-0000"
                                   Text="{Binding Telefono}"
                                   Keyboard="Telephone"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Selector de Tratamiento / Servicio -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tratamiento o Servicio *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Picker ItemsSource="{Binding Servicios}"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    SelectedItem="{Binding ServicioSeleccionado}"
                                    Title="Selecciona un servicio" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Selector de Estilista -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Estilista Asignada *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Picker ItemsSource="{Binding Estilistas}"
                                    ItemDisplayBinding="{Binding NombreCompleto}"
                                    SelectedItem="{Binding EstilistaSeleccionado}"
                                    Title="Selecciona una profesional" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Hora de Atención -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Hora de Atención Estimada *" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <TimePicker Time="{Binding HoraAtencion}"
                                        Format="hh:mm tt" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Observaciones -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Observaciones o Notas" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextColorPrimary}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry Placeholder="ej. Cliente solicita atención inmediata"
                                   Text="{Binding Notas}"
                                   ReturnType="Done" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botón Agendar -->
                    <Button Text="➕ Confirmar Cita Walk-In"
                            Command="{Binding RegistrarWalkInCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="0,8,0,0" />

                    <!-- Botón Cancelar -->
                    <Button Text="Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HeightRequest="42" />

                    <!-- Indicador de Carga -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HeightRequest="30" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
