<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminConversationPage"
    x:DataType="vm:AdminConversationViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="AdminBubble" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="MaximumWidthRequest" Value="280" />
            </Style>
            <Style x:Key="ClientBubble" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="BorderColor" Value="{StaticResource Border}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="MaximumWidthRequest" Value="280" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
            <Grid ColumnDefinitions="40,*,40">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.svg"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label Text="{Binding Title}" FontFamily="PlayfairDisplay" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Atención al Cliente" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" VerticalOptions="End" Margin="0,12,0,-16" />
        </Grid>

        <!-- 2. ESTADO VACÍO -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowEmptyState}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16" Padding="32,100,32,32">
                <Label Text="💬" FontSize="38" HorizontalOptions="Center" />
                <Label Text="Conversación iniciada" FontFamily="PlayfairDisplay" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                <Label Text="Escribe una respuesta para comunicarte directamente con el cliente." FontFamily="PlusJakartaSans" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. LISTA DE MENSAJES -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}" Margin="16,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:ChatMessageItem">
                    <Grid Margin="0,4">
                        <!-- Mensaje enviado por el Administrador (propio) -->
                        <Frame Style="{StaticResource AdminBubble}" IsVisible="{Binding EsMio}">
                            <VerticalStackLayout Spacing="4">
                                <Image
                                    IsVisible="{Binding TieneImagen}"
                                    Source="{Binding ImagenUrl}"
                                    Aspect="AspectFill"
                                    MaximumHeightRequest="200"
                                    MaximumWidthRequest="220"
                                    HorizontalOptions="End" />
                                <Label
                                    IsVisible="{Binding TieneTexto}"
                                    Text="{Binding Content}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    TextColor="{StaticResource TextLight}" />
                                <Label Text="{Binding TimeDisplay}" FontFamily="PlusJakartaSans" FontSize="10" TextColor="#FFFFFF99" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Mensaje enviado por el Cliente -->
                        <Frame Style="{StaticResource ClientBubble}" IsVisible="{Binding NoEsMio}">
                            <VerticalStackLayout Spacing="4">
                                <Image
                                    IsVisible="{Binding TieneImagen}"
                                    Source="{Binding ImagenUrl}"
                                    Aspect="AspectFill"
                                    MaximumHeightRequest="200"
                                    MaximumWidthRequest="220"
                                    HorizontalOptions="Start" />
                                <Label
                                    IsVisible="{Binding TieneTexto}"
                                    Text="{Binding Content}"
                                    FontFamily="PlusJakartaSans"
                                    FontSize="14"
                                    TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding TimeDisplay}" FontFamily="PlusJakartaSans" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 4. COMPOSITOR DE RESPUESTA ADMIN -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}" Padding="12,10,12,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Banner de Error si ocurre -->
            <Frame
                Grid.Row="0"
                IsVisible="{Binding HasError}"
                BackgroundColor="#FFEBEE"
                BorderColor="#FFCDD2"
                CornerRadius="8"
                Padding="12,8"
                HasShadow="False"
                Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding ErrorMessage}" FontFamily="PlusJakartaSans" FontSize="12" TextColor="#C62828" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="✕" Command="{Binding DismissErrorCommand}" BackgroundColor="Transparent" TextColor="#C62828" FontSize="14" HeightRequest="28" WidthRequest="28" Padding="0" />
                </Grid>
            </Frame>

            <!-- Input bar -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <!-- Botón adjuntar imagen -->
                <Frame
                    Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    HasShadow="False"
                    BackgroundColor="{StaticResource InputBackground}">
                    <Button
                        Text="📷"
                        Command="{Binding AttachImageCommand}"
                        BackgroundColor="Transparent"
                        FontSize="18"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Frame>

                <Frame
                    Grid.Column="1"
                    BackgroundColor="{StaticResource InputBackground}"
                    BorderColor="{StaticResource Border}"
                    CornerRadius="24"
                    Padding="16,0"
                    HasShadow="False"
                    HeightRequest="48">
                    <Entry
                        Text="{Binding MessageText}"
                        Placeholder="Escribe una respuesta como Administrador..."
                        PlaceholderColor="{StaticResource TextSecondary}"
                        TextColor="{StaticResource TextPrimary}"
                        FontFamily="PlusJakartaSans"
                        FontSize="14"
                        VerticalOptions="Center"
                        ReturnCommand="{Binding EnviarRespuestaCommand}" />
                </Frame>

                <Button
                    Grid.Column="2"
                    Text="➤"
                    Command="{Binding EnviarRespuestaCommand}"
                    IsVisible="{Binding IsNotSending}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource TextLight}"
                    FontSize="18"
                    CornerRadius="24"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

                <ActivityIndicator
                    Grid.Column="2"
                    IsRunning="True"
                    IsVisible="{Binding IsSending}"
                    Color="{StaticResource Primary}"
                    WidthRequest="44"
                    HeightRequest="44" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
