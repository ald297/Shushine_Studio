<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.TimelineAgendaPage"
    x:DataType="vm:TimelineAgendaViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Agenda">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- 1. HEADER SUPERIOR -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
            <Grid ColumnDefinitions="40,*,40">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.svg"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            Text="Agenda del Salón"
                            FontFamily="PlayfairDisplay"
                            FontSize="18" FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Frame
                            BackgroundColor="{StaticResource Secondary}"
                            CornerRadius="4"
                            Padding="5,1"
                            HasShadow="False"
                            VerticalOptions="Center">
                            <Label Text="ADMIN" FontFamily="PlusJakartaSans" FontSize="8" FontAttributes="Bold" TextColor="{StaticResource Surface}" />
                        </Frame>
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="2" WidthRequest="40" BackgroundColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="Hoy"
                    Command="{Binding IrAHoyCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontFamily="PlusJakartaSans"
                    FontSize="12" FontAttributes="Bold"
                    Padding="0"
                    HeightRequest="36" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,14,0,0" VerticalOptions="End" />
        </Grid>

        <!-- 2. SELECTOR DE FECHA BOUTIQUE -->
        <Frame
            Grid.Row="1"
            BackgroundColor="{StaticResource Surface}"
            BorderColor="{StaticResource Border}"
            CornerRadius="16"
            Padding="12,8"
            Margin="16,12,16,6"
            HasShadow="False">
            <Grid ColumnDefinitions="40,*,40">
                <Button
                    Grid.Column="0"
                    Text="‹"
                    Command="{Binding DiaAnteriorCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="22" FontAttributes="Bold"
                    WidthRequest="36" HeightRequest="36"
                    Padding="0" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label
                        Text="{Binding FechaTexto}"
                        FontFamily="PlayfairDisplay"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="›"
                    Command="{Binding DiaSiguienteCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="22" FontAttributes="Bold"
                    WidthRequest="36" HeightRequest="36"
                    Padding="0" />
            </Grid>
        </Frame>

        <!-- 3. CHIPS SELECTOR DE ESTILISTA -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,6">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding EstilistasFiltro}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EstilistaChipItem">
                        <Button
                            Text="{Binding Nombre}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimelineAgendaViewModel}}, Path=FiltrarPorEstilistaCommand}"
                            CommandParameter="{Binding .}"
                            FontSize="12" HeightRequest="34" CornerRadius="17"
                            Padding="14,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="{StaticResource Surface}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 4. CONTADOR Y SUBTÍTULO DE LA AGENDA -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="20,8,20,4">
            <Label
                Grid.Column="0"
                Text="Línea de Tiempo Operativa"
                FontFamily="PlusJakartaSans"
                FontSize="12" FontAttributes="Bold"
                TextColor="{StaticResource Secondary}"
                CharacterSpacing="1" />
            <Label
                Grid.Column="1"
                Text="{Binding TotalCitas, StringFormat='{0} citas'}"
                FontFamily="PlusJakartaSans"
                FontSize="12" FontAttributes="Bold"
                TextColor="{StaticResource Primary}" />
        </Grid>

        <!-- 5. LISTA TIMELINE VERTICAL DE CITAS -->
        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAgendaCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,24" Spacing="10">

                    <!-- MENSAJE DE ERROR -->
                    <Frame
                        IsVisible="{Binding ErrorMessage, Converter={x:Null}}"
                        BackgroundColor="#FEF2F2"
                        BorderColor="#FCA5A5"
                        CornerRadius="12"
                        Padding="14,10"
                        HasShadow="False">
                        <Label Text="{Binding ErrorMessage}"
                               FontFamily="PlusJakartaSans"
                               FontSize="12"
                               TextColor="#991B1B"
                               HorizontalTextAlignment="Center" />
                    </Frame>

                    <!-- ESTADO VACÍO -->
                    <Frame
                        IsVisible="{Binding EstaVacio}"
                        BackgroundColor="{StaticResource Surface}"
                        BorderColor="{StaticResource Border}"
                        CornerRadius="16"
                        Padding="24,32"
                        Margin="0,16"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="📅" FontSize="36" HorizontalOptions="Center" />
                            <Label
                                Text="Sin Citas para esta Fecha"
                                FontFamily="PlayfairDisplay"
                                FontSize="17" FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="No hay tratamientos agendados para este día con el filtro actual."
                                FontFamily="PlusJakartaSans"
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalTextAlignment="Center"
                                LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- COLECCIÓN DE CITAS (TIMELINE) -->
                    <CollectionView ItemsSource="{Binding CitasFiltradas}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:Reserva">
                                <Grid ColumnDefinitions="48,4,*" ColumnSpacing="10" Margin="0,0,0,10">
                                    
                                    <!-- HORA LATERAL -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Start" HorizontalOptions="End" Margin="0,8,0,0">
                                        <Label Text="{Binding HoraInicio}"
                                               FontFamily="PlusJakartaSans"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding HoraFin}"
                                               FontFamily="PlusJakartaSans"
                                               FontSize="10"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <!-- BARRA VERTICAL ROSA LOTO -->
                                    <BoxView Grid.Column="1"
                                             BackgroundColor="{StaticResource Secondary}"
                                             CornerRadius="2"
                                             VerticalOptions="Fill" />

                                    <!-- TARJETA BOUTIQUE DE CITA -->
                                    <Frame
                                        Grid.Column="2"
                                        BackgroundColor="{StaticResource Surface}"
                                        BorderColor="{StaticResource Border}"
                                        CornerRadius="14"
                                        Padding="14,12"
                                        HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimelineAgendaViewModel}}, Path=IrADetalleCitaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding ClienteNombre}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="14" FontAttributes="Bold"
                                                    TextColor="{StaticResource TextPrimary}" />
                                                <Frame
                                                    Grid.Column="1"
                                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                                    BorderColor="{Binding EstadoColor}"
                                                    CornerRadius="6"
                                                    Padding="6,2"
                                                    HasShadow="False">
                                                    <Label
                                                        Text="{Binding EstadoDisplay}"
                                                        FontFamily="PlusJakartaSans"
                                                        FontSize="9" FontAttributes="Bold"
                                                        TextColor="{Binding EstadoColor}" />
                                                </Frame>
                                            </Grid>

                                            <Label
                                                Text="{Binding ServicioNombre}"
                                                FontFamily="PlusJakartaSans"
                                                FontSize="12"
                                                TextColor="{StaticResource TextSecondary}" />

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding EstilistaNombre, StringFormat='👩‍🎨 {0}'}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="11"
                                                    TextColor="{StaticResource Secondary}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding TotalFormateado}"
                                                    FontFamily="PlusJakartaSans"
                                                    FontSize="13" FontAttributes="Bold"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
