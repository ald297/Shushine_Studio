<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
             xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
             x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.TimelineAgendaPage"
             x:DataType="vm:TimelineAgendaViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- Navegador de fecha -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource SurfaceColor}"
                StrokeThickness="0"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0"
                        Text="‹"
                        Command="{Binding DiaAnteriorCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryDark}"
                        FontSize="22"
                        FontAttributes="Bold"
                        WidthRequest="44" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="1">
                    <Label Text="{Binding FechaSeleccionada, StringFormat='{0:dddd}'}"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding FechaSeleccionada, StringFormat='{0:dd MMMM yyyy}'}"
                           FontSize="12"
                           TextColor="{StaticResource TextColorSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        Text="›"
                        Command="{Binding DiaSiguienteCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryDark}"
                        FontSize="22"
                        FontAttributes="Bold"
                        WidthRequest="44" />
            </Grid>
        </Border>

        <!-- Filtro de estilistas (horizontal scroll chips) (Wireframe Pág. 16) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Padding="16,8">
            <HorizontalStackLayout Spacing="8">
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        Padding="14,7">
                    <Label Text="Todas" FontSize="13" TextColor="White" FontAttributes="Bold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoadAgendaCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="{StaticResource BorderColor}"
                        Padding="14,7">
                    <Label Text="Sofía Ramos" FontSize="13" TextColor="{StaticResource TextColorPrimary}" />
                </Border>
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="{StaticResource BorderColor}"
                        Padding="14,7">
                    <Label Text="Valentina Gómez" FontSize="13" TextColor="{StaticResource TextColorPrimary}" />
                </Border>
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="{StaticResource BorderColor}"
                        Padding="14,7">
                    <Label Text="Camila Torres" FontSize="13" TextColor="{StaticResource TextColorPrimary}" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Botón Walk-In Rápido -->
        <Border Grid.Row="2" Padding="16,6" BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0">
            <Button Text="➕  Agregar Cita Walk-In Presencial"
                    Command="{Binding AgregarWalkInCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontSize="13"
                    HeightRequest="42" />
        </Border>

        <!-- Lista de citas del día en formato agenda -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAgendaCommand}">
            <CollectionView ItemsSource="{Binding CitasDelDia}" SelectionMode="None" Margin="16,8,16,0">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="12" VerticalOptions="Center">
                        <Label Text="📅" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Sin citas agendadas para este día"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="{StaticResource TextColorPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="Puedes agregar una cita presencial con el botón Walk-In."
                               FontSize="12"
                               TextColor="{StaticResource TextColorSecondary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Reserva">
                        <!-- Fila tipo timeline con línea lateral de color según estado -->
                        <Grid ColumnDefinitions="50, 8, *" Margin="0,0,0,12" ColumnSpacing="10">

                            <!-- Hora de inicio -->
                            <Label Grid.Column="0"
                                   Text="{Binding FechaHoraInicio, StringFormat='{0:hh:mm}'}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}"
                                   VerticalOptions="Start"
                                   HorizontalOptions="End"
                                   Margin="0,14,0,0" />

                            <!-- Línea de tiempo lateral -->
                            <BoxView Grid.Column="1"
                                     WidthRequest="5"
                                     BackgroundColor="{StaticResource PrimaryColor}"
                                     CornerRadius="3"
                                     VerticalOptions="Fill" />

                            <!-- Tarjeta de cita -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding ServicioNombre}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextColorPrimary}" />
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource SecondaryLight}"
                                                Padding="8,3">
                                            <Label Text="{Binding Estado}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding EstilistaNombre, StringFormat='👩‍🎨 {0}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextColorSecondary}" />
                                    <Label Text="{Binding CodigoReserva, StringFormat='🏷 {0}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextColorSecondary}" />
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Total, StringFormat='Total: ${0:F2}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="⚙ Estado"
                                                FontSize="11"
                                                HeightRequest="34"
                                                Padding="10,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimelineAgendaViewModel}}, Path=CambiarEstadoReservaCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
