<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Admin"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Admin.AdminRequestDetailPage"
    x:DataType="vm:AdminRequestDetailViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="20,50,20,16">
            <Grid ColumnDefinitions="40,*,40">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.png"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Detalle de Solicitud" FontFamily="PlayfairDisplay" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Módulo Preparado" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1" Padding="20,20,20,32">
            <VerticalStackLayout Spacing="20">
                <Border Stroke="#FFE0B2" StrokeThickness="1" BackgroundColor="#FFF8E1" StrokeShape="RoundRectangle 12" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="⚠️" FontSize="22" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="UI Preparada — Backend No Disponible" FontFamily="PlusJakartaSans" FontSize="13" FontAttributes="Bold" TextColor="#E65100" />
                            <Label Text="{Binding AvisoBackend}" FontFamily="PlusJakartaSans" FontSize="12" TextColor="#795548" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Stroke="{StaticResource Outline}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Gestión Técnica de Cotizaciones" FontFamily="PlayfairDisplay" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Esta pantalla permitirá al administrador revisar la fotografía de referencia aportada por la clienta, estimar insumos y tiempo requerido, proponer una cotización formal y opcionalmente convertir la cotización aceptada en una cita en la agenda." FontFamily="PlusJakartaSans" FontSize="12" TextColor="{StaticResource TextSecondary}" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Regresar" Command="{Binding RegresarCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
