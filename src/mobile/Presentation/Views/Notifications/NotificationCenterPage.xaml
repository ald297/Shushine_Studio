<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShushineStudio.Mobile.Presentation.ViewModels.Notifications"
    xmlns:entities="clr-namespace:ShushineStudio.Mobile.Domain.Entities"
    x:Class="ShushineStudio.Mobile.Presentation.Views.Notifications.NotificationCenterPage"
    x:DataType="vm:NotificationCenterViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="false"
    Title="Notificaciones">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Surface}" Padding="16,52,16,16">
            <Grid ColumnDefinitions="44,*,Auto">
                <ImageButton
                    Grid.Column="0"
                    Source="arrow_left.png"
                    Command="{Binding RegresarCommand}"
                    WidthRequest="28" HeightRequest="28"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="Notificaciones"
                        FontFamily="PlayfairDisplay"
                        FontSize="18" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalOptions="Center" />
                    <BoxView HeightRequest="2" WidthRequest="40"
                             BackgroundColor="{StaticResource Secondary}"
                             HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="Marcar leídas"
                    Command="{Binding MarcarTodasLeidasCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="12"
                    FontFamily="PlusJakartaSans"
                    FontAttributes="Bold"
                    Padding="4,0"
                    HeightRequest="36" />
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,12,0,0" />
        </Grid>

        <!-- CUERPO PRINCIPAL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,32" Spacing="20">

                <!-- INTRODUCCIÓN ATELIER -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Atelier &amp; Sanctuary"
                        FontFamily="PlusJakartaSans"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Secondary}"
                        CharacterSpacing="1" />
                    <Label
                        Text="Centro de Avisos y Novedades"
                        FontFamily="PlayfairDisplay"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />
                    <Label
                        Text="Mantente al día con recordatorios de tus tratamientos, respuestas de estilistas y novedades exclusivas."
                        FontFamily="PlusJakartaSans"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}"
                        LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- CHIPS DE FILTRO DE CATEGORÍAS -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button
                            Text="Todas"
                            Command="{Binding FiltrarCategoriaCommand}"
                            CommandParameter="Todas"
                            FontSize="12" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource Surface}"
                            Padding="14,0" />
                        <Button
                            Text="No leídas"
                            Command="{Binding FiltrarCategoriaCommand}"
                            CommandParameter="No leídas"
                            FontSize="12" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="{StaticResource SurfaceVariant}"
                            TextColor="{StaticResource TextPrimary}"
                            Padding="14,0" />
                        <Button
                            Text="Citas"
                            Command="{Binding FiltrarCategoriaCommand}"
                            CommandParameter="Citas"
                            FontSize="12" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="{StaticResource SurfaceVariant}"
                            TextColor="{StaticResource TextPrimary}"
                            Padding="14,0" />
                        <Button
                            Text="Mensajes"
                            Command="{Binding FiltrarCategoriaCommand}"
                            CommandParameter="Mensajes"
                            FontSize="12" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="{StaticResource SurfaceVariant}"
                            TextColor="{StaticResource TextPrimary}"
                            Padding="14,0" />
                        <Button
                            Text="Solicitudes"
                            Command="{Binding FiltrarCategoriaCommand}"
                            CommandParameter="Solicitudes"
                            FontSize="12" HeightRequest="36" CornerRadius="18"
                            BackgroundColor="{StaticResource SurfaceVariant}"
                            TextColor="{StaticResource TextPrimary}"
                            Padding="14,0" />
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- LISTA DE NOTIFICACIONES (SI EXISTEN EN BACKEND) -->
                <CollectionView ItemsSource="{Binding NotificacionesFiltradas}"
                                IsVisible="{Binding TieneNotificaciones}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:NotificacionItem">
                            <Frame
                                BackgroundColor="{StaticResource Surface}"
                                BorderColor="{StaticResource Border}"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,0,0,10"
                                HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="🔔" FontSize="22" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Titulo}" FontFamily="PlusJakartaSans" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                            <Label Grid.Column="1" Text="{Binding FechaTexto}" FontFamily="PlusJakartaSans" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        </Grid>
                                        <Label Text="{Binding Mensaje}" FontFamily="PlusJakartaSans" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ESTADO VACÍO PREPARADO (SIN NOTIFICACIONES EN BACKEND) -->
                <Frame
                    IsVisible="{Binding EstaVacio}"
                    BackgroundColor="{StaticResource Surface}"
                    BorderColor="{StaticResource Border}"
                    CornerRadius="18"
                    Padding="24,32"
                    HasShadow="False">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Frame
                            WidthRequest="72" HeightRequest="72"
                            CornerRadius="36"
                            BackgroundColor="#FBF7F2"
                            BorderColor="{StaticResource Secondary}"
                            Padding="0"
                            HorizontalOptions="Center"
                            HasShadow="False">
                            <Label
                                Text="🔔"
                                FontSize="32"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Frame>

                        <Label
                            Text="Sin Notificaciones Pendientes"
                            FontFamily="PlayfairDisplay"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Las notificaciones estarán disponibles cuando el servicio de notificaciones esté conectado."
                            FontFamily="PlusJakartaSans"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalTextAlignment="Center"
                            LineHeight="1.3" />

                        <Frame
                            BackgroundColor="#F8F5F1"
                            BorderColor="{StaticResource Border}"
                            CornerRadius="12"
                            Padding="14,10"
                            HasShadow="False"
                            HorizontalOptions="Center">
                            <Label
                                Text="ℹ️ El servidor aún no cuenta con un microservicio de avisos push o bandeja activa."
                                FontFamily="PlusJakartaSans"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalTextAlignment="Center" />
                        </Frame>

                        <Button
                            Text="Configurar Preferencias"
                            Command="{Binding IrAPreferenciasCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HeightRequest="46"
                            FontSize="13"
                            CornerRadius="12"
                            Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
