<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta Cromática Oficial - Shushine Studio -->
    <Color x:Key="PrimaryColor">#D48B96</Color>
    <Color x:Key="PrimaryDark">#B86F7A</Color>
    <Color x:Key="PrimaryLight">#E8A598</Color>
    
    <Color x:Key="SecondaryColor">#D8B4E2</Color>
    <Color x:Key="SecondaryLight">#F2E6F7</Color>
    
    <Color x:Key="BackgroundColor">#FDF6F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#F7F3F3</Color>

    <Color x:Key="TextColorPrimary">#2D2926</Color>
    <Color x:Key="TextColorSecondary">#7A7579</Color>
    <Color x:Key="TextLight">#FFFFFF</Color>

    <Color x:Key="BorderColor">#E8E0E0</Color>
    <Color x:Key="DividerColor">#EFEAE9</Color>

    <!-- Estados -->
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#ED6C02</Color>
    <Color x:Key="ErrorColor">#D32F2F</Color>
    <Color x:Key="InfoColor">#0288D1</Color>

    <!-- Pinceles (Brushes) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

</ResourceDictionary>
