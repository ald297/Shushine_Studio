<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShushineStudio.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Auth"
    xmlns:home="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Home"
    xmlns:catalog="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Catalog"
    xmlns:appointments="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Appointments"
    xmlns:profile="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Profile"
    xmlns:chat="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Chat"
    xmlns:admin="clr-namespace:ShushineStudio.Mobile.Presentation.Views.Admin"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="false"
    Shell.BackgroundColor="{StaticResource BackgroundColor}"
    Shell.ForegroundColor="{StaticResource TextColorPrimary}"
    Shell.TitleColor="{StaticResource TextColorPrimary}"
    Shell.TabBarBackgroundColor="{StaticResource SurfaceColor}"
    Shell.TabBarForegroundColor="{StaticResource PrimaryColor}"
    Shell.TabBarUnselectedColor="{StaticResource TextColorSecondary}"
    Shell.TabBarTitleColor="{StaticResource PrimaryColor}">

    <!-- Pantalla de Login fuera de las pestañas -->
    <ShellContent
        x:Name="LoginShellContent"
        Route="LoginPage"
        ContentTemplate="{DataTemplate auth:LoginPage}" />

    <!-- ====================================================
         BARRA CLIENTE: Inicio | Catálogo | Citas | Chat | Perfil
         ==================================================== -->
    <TabBar x:Name="ClientTabBar" Route="MainTabs">

        <!-- Inicio: pantalla de bienvenida con accesos rápidos -->
        <Tab Title="Inicio" Icon="home.svg">
            <ShellContent
                Route="ClientHomePage"
                ContentTemplate="{DataTemplate home:ClientHomePage}" />
        </Tab>

        <!-- Catálogo: servicios (root) con selector Servicios/Productos -->
        <Tab Title="Catálogo" Icon="scissors.svg">
            <ShellContent
                Route="CatalogPage"
                ContentTemplate="{DataTemplate catalog:CatalogPage}" />
        </Tab>

        <!-- Citas del cliente -->
        <Tab Title="Citas" Icon="calendar.svg">
            <ShellContent
                Route="MyAppointmentsPage"
                ContentTemplate="{DataTemplate appointments:MyAppointmentsPage}" />
        </Tab>

        <!-- Chat con el salón -->
        <Tab Title="Chat" Icon="chat.svg">
            <ShellContent
                Route="ChatPage"
                ContentTemplate="{DataTemplate chat:ChatPage}" />
        </Tab>

        <!-- Perfil del cliente -->
        <Tab Title="Perfil" Icon="user.svg">
            <ShellContent
                Route="ProfilePage"
                ContentTemplate="{DataTemplate profile:ProfilePage}" />
        </Tab>

    </TabBar>

    <!-- ====================================================
         BARRA ADMIN: Agenda | Catálogo | Estilistas | Mensajes | Perfil
         ==================================================== -->
    <TabBar x:Name="AdminTabBar" Route="AdminTabs">

        <!-- Agenda: hub con Timeline, Citas, Nueva Cita, Walk-In -->
        <Tab Title="Agenda" Icon="calendar.svg">
            <ShellContent
                Route="AdminAgendaHubPage"
                ContentTemplate="{DataTemplate admin:AdminAgendaHubPage}" />
        </Tab>

        <!-- Catálogo admin: hub con Servicios y Productos -->
        <Tab Title="Catálogo" Icon="scissors.svg">
            <ShellContent
                Route="AdminCatalogHubPage"
                ContentTemplate="{DataTemplate admin:AdminCatalogHubPage}" />
        </Tab>

        <!-- Estilistas -->
        <Tab Title="Estilistas" Icon="user.svg">
            <ShellContent
                Route="AdminEstilistasPage"
                ContentTemplate="{DataTemplate admin:AdminEstilistasPage}" />
        </Tab>

        <!-- Mensajes: hub con Conversaciones, Solicitudes, Cotizaciones, Reseñas -->
        <Tab Title="Mensajes" Icon="chat.svg">
            <ShellContent
                Route="AdminMessagesPage"
                ContentTemplate="{DataTemplate admin:AdminMessagesPage}" />
        </Tab>

        <!-- Perfil del administrador -->
        <Tab Title="Perfil" Icon="user.svg">
            <ShellContent
                Route="AdminProfilePage"
                ContentTemplate="{DataTemplate admin:AdminProfilePage}" />
        </Tab>

    </TabBar>

</Shell>
